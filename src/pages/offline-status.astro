---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<Base title="Offline-Status">
  <article class="offline-diag">
    <header class="offline-diag-head">
      <h1 class="offline-diag-title">Offline-Status</h1>
      <p class="offline-diag-subtitle">Diagnose der lokalen Offline-Bereitstellung dieser App.</p>
    </header>

    <section class="offline-diag-section">
      <h2>Verbindung</h2>
      <dl class="offline-diag-dl">
        <dt>Online</dt><dd id="diag-online">…</dd>
        <dt>Standalone (PWA installiert)</dt><dd id="diag-standalone">…</dd>
        <dt>User-Agent</dt><dd id="diag-ua">…</dd>
      </dl>
    </section>

    <section class="offline-diag-section">
      <h2>Service Worker</h2>
      <dl class="offline-diag-dl">
        <dt>Unterstützt</dt><dd id="diag-sw-support">…</dd>
        <dt>Registriert</dt><dd id="diag-sw-reg">…</dd>
        <dt>Scope</dt><dd id="diag-sw-scope">…</dd>
        <dt>State</dt><dd id="diag-sw-state">…</dd>
        <dt>Controller aktiv</dt><dd id="diag-sw-ctrl">…</dd>
      </dl>
    </section>

    <section class="offline-diag-section">
      <h2>Cache</h2>
      <dl class="offline-diag-dl">
        <dt>Cache Storage</dt><dd id="diag-cache-support">…</dd>
        <dt>Anzahl Caches</dt><dd id="diag-cache-count">…</dd>
        <dt>Gesamteinträge</dt><dd id="diag-entry-count">…</dd>
        <dt>Aktuelle Seite im Cache</dt><dd id="diag-self-cached">…</dd>
      </dl>
      <p class="offline-diag-hint" id="diag-no-content" hidden>
        Cache ist leer — der Service Worker hat noch keine Inhalte vorgeladen. Online gehen, Seite neu laden, einen Moment warten, dann hierher zurückkehren.
      </p>
    </section>

    <section class="offline-diag-section">
      <h2>Caches und Beispiel-URLs</h2>
      <div id="diag-caches">…</div>
    </section>

    <section class="offline-diag-section">
      <h2>Aktionen</h2>
      <div class="offline-diag-actions">
        <button class="offline-diag-btn" id="diag-update">Service Worker prüfen / aktualisieren</button>
        <button class="offline-diag-btn offline-diag-btn--danger" id="diag-purge">
          Alle Caches und SW löschen
        </button>
      </div>
      <p class="offline-diag-hint">
        Nach „Caches löschen" einmal online gehen und die Startseite aufrufen — dann installiert sich der Service Worker neu mit dem aktuellen Stand.
      </p>
    </section>

    <p class="vortrag-back">
      <a href={base}>← Zum Mantren-Index</a>
    </p>
  </article>

  <script is:inline>
    (function () {
      function setText(id, v) {
        var el = document.getElementById(id);
        if (el) el.textContent = String(v);
      }
      function setOk(id, ok) {
        var el = document.getElementById(id);
        if (!el) return;
        el.classList.toggle('is-ok', !!ok);
        el.classList.toggle('is-bad', !ok);
      }

      // Verbindung
      function refreshOnline() {
        var on = navigator.onLine;
        setText('diag-online', on ? 'ja' : 'nein (Offline)');
        setOk('diag-online', on);
      }
      refreshOnline();
      window.addEventListener('online', refreshOnline);
      window.addEventListener('offline', refreshOnline);

      var standalone = window.matchMedia('(display-mode: standalone)').matches
        || window.navigator.standalone === true;
      setText('diag-standalone', standalone ? 'ja' : 'nein (im Browser-Tab)');
      setOk('diag-standalone', standalone);

      setText('diag-ua', navigator.userAgent);

      // Service Worker
      var swSupport = 'serviceWorker' in navigator;
      setText('diag-sw-support', swSupport ? 'ja' : 'nein');
      setOk('diag-sw-support', swSupport);

      if (!swSupport) {
        setText('diag-sw-reg', '–');
        setText('diag-sw-scope', '–');
        setText('diag-sw-state', '–');
        setText('diag-sw-ctrl', '–');
      } else {
        navigator.serviceWorker.getRegistration().then(function (reg) {
          if (!reg) {
            setText('diag-sw-reg', 'nein');
            setOk('diag-sw-reg', false);
            setText('diag-sw-scope', '–');
            setText('diag-sw-state', '–');
          } else {
            setText('diag-sw-reg', 'ja');
            setOk('diag-sw-reg', true);
            setText('diag-sw-scope', reg.scope);
            var w = reg.active || reg.waiting || reg.installing;
            setText('diag-sw-state', w ? w.state : 'unbekannt');
            setOk('diag-sw-state', !!(reg.active && reg.active.state === 'activated'));
          }
        });
        var ctrl = navigator.serviceWorker.controller;
        setText('diag-sw-ctrl', ctrl ? 'ja (' + ctrl.scriptURL.split('/').pop() + ')' : 'nein');
        setOk('diag-sw-ctrl', !!ctrl);
      }

      // Caches
      var cachesSupport = typeof caches !== 'undefined';
      setText('diag-cache-support', cachesSupport ? 'ja' : 'nein');
      setOk('diag-cache-support', cachesSupport);

      var listEl = document.getElementById('diag-caches');
      if (!cachesSupport) {
        if (listEl) listEl.textContent = '–';
        setText('diag-cache-count', '0');
        setText('diag-entry-count', '0');
      } else {
        caches.keys().then(function (names) {
          setText('diag-cache-count', String(names.length));
          if (names.length === 0) {
            if (listEl) listEl.innerHTML = '<p>Keine Caches angelegt.</p>';
            setText('diag-entry-count', '0');
            var hint = document.getElementById('diag-no-content');
            if (hint) hint.hidden = false;
            return;
          }
          Promise.all(names.map(function (n) {
            return caches.open(n).then(function (c) {
              return c.keys().then(function (reqs) {
                return { name: n, urls: reqs.map(function (r) { return r.url; }) };
              });
            });
          })).then(function (caches_) {
            var total = caches_.reduce(function (s, c) { return s + c.urls.length; }, 0);
            setText('diag-entry-count', String(total));

            // Prüfen, ob aktueller Pfad im Cache liegt
            var self = location.href.split('#')[0].split('?')[0];
            var matched = caches_.some(function (c) {
              return c.urls.indexOf(self) >= 0
                || c.urls.indexOf(self.replace(/\/$/, '')) >= 0
                || c.urls.indexOf(self + '/') >= 0;
            });
            setText('diag-self-cached', matched ? 'ja' : 'nein');
            setOk('diag-self-cached', matched);

            var html = '';
            caches_.forEach(function (c) {
              html += '<details class="offline-diag-cache"><summary>'
                + '<span class="offline-diag-cache-name">' + c.name + '</span>'
                + '<span class="offline-diag-cache-count">' + c.urls.length + ' Einträge</span>'
                + '</summary>';
              if (c.urls.length === 0) {
                html += '<p class="offline-diag-empty">(leer)</p>';
              } else {
                html += '<ul class="offline-diag-list">';
                c.urls.slice(0, 200).sort().forEach(function (u) {
                  html += '<li>' + u + '</li>';
                });
                if (c.urls.length > 200) html += '<li>… (' + (c.urls.length - 200) + ' weitere)</li>';
                html += '</ul>';
              }
              html += '</details>';
            });
            if (listEl) listEl.innerHTML = html;
          });
        });
      }

      // Aktionen
      var updateBtn = document.getElementById('diag-update');
      if (updateBtn) updateBtn.addEventListener('click', function () {
        if (!swSupport) return;
        navigator.serviceWorker.getRegistration().then(function (reg) {
          if (!reg) {
            alert('Kein Service Worker registriert. Online gehen und Startseite neu laden.');
            return;
          }
          reg.update().then(function () {
            alert('Update-Versuch angestoßen. Diese Seite einmal neu laden.');
          });
        });
      });

      var purgeBtn = document.getElementById('diag-purge');
      if (purgeBtn) purgeBtn.addEventListener('click', function () {
        if (!confirm('Alle Caches und Service Worker dieser App löschen?')) return;
        var jobs = [];
        if (cachesSupport) {
          jobs.push(caches.keys().then(function (names) {
            return Promise.all(names.map(function (n) { return caches.delete(n); }));
          }));
        }
        if (swSupport) {
          jobs.push(navigator.serviceWorker.getRegistrations().then(function (regs) {
            return Promise.all(regs.map(function (r) { return r.unregister(); }));
          }));
        }
        try { localStorage.removeItem('offline-ready-v1'); } catch (e) {}
        Promise.all(jobs).then(function () {
          alert('Caches und Service Worker entfernt. Jetzt online gehen und Startseite neu laden.');
          location.reload();
        });
      });
    })();
  </script>
</Base>

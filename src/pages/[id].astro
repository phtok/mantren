---
import Base from '../layouts/Base.astro';
import MantraView from '../components/MantraView.astro';
import KommentarKlappe from '../components/KommentarKlappe.astro';
import LectureView from '../components/LectureView.astro';
import { mantren, neighbours, chapters, rollingTitle, type Mantra } from '../lib/mantren';
import { vortraege, vortragNeighbours, type Vortrag } from '../lib/vortraege';
import { kommentareForMantra, firstTafelbild } from '../lib/kommentar';

type Props =
  | { kind: 'mantra'; mantra: Mantra }
  | { kind: 'vortrag'; vortrag: Vortrag };

export function getStaticPaths() {
  const mantraPaths = mantren.map((m) => ({
    params: { id: m.id },
    props: { kind: 'mantra' as const, mantra: m },
  }));
  const vortragPaths = vortraege.map((v) => ({
    params: { id: v.id },
    props: { kind: 'vortrag' as const, vortrag: v },
  }));
  return [...mantraPaths, ...vortragPaths];
}

const props = Astro.props as Props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

let pageTitle = 'Mantren';
let chapter: string | undefined;
let number: string | undefined;
let section: string | undefined;
let prevHref: string | null = null;
let prevLabel = '';
let nextHref: string | null = null;
let nextLabel = '';
let homeHref = base;

if (props.kind === 'mantra') {
  const m = props.mantra;
  const { prev, next } = neighbours(m.id);
  const chapterMeta = chapters.find((c) => c.id === m.chapter);
  section = rollingTitle(m.id);
  pageTitle = section
    ? `${m.number ? m.number + ' · ' : ''}${section}`
    : (m.number || chapterMeta?.title || 'Mantra');
  chapter = chapterMeta?.title;
  number = m.number;
  prevHref = prev ? `${base}${prev.id}` : null;
  prevLabel = prev ? (prev.number || prev.id) : '';
  nextHref = next ? `${base}${next.id}` : null;
  nextLabel = next ? (next.number || next.id) : '';
  homeHref = base;
} else {
  const v = props.vortrag;
  const { prev, next } = vortragNeighbours(v.id);
  pageTitle = v.titel;
  chapter = `${v.ort} · ${v.datum} · GA ${v.ga}, S. ${v.seiten}`;
  number = v.titel;
  section = undefined;
  prevHref = prev ? `${base}${prev.id}` : null;
  prevLabel = prev ? prev.titel : '';
  nextHref = next ? `${base}${next.id}` : null;
  nextLabel = next ? next.titel : '';
  homeHref = `${base}vortraege`;
}

const kommentare = props.kind === 'mantra' ? kommentareForMantra(props.mantra) : undefined;
const pageKommentar = kommentare && kommentare.mode === 'page' ? kommentare.entries[0] : undefined;
const perPartKommentare = kommentare && kommentare.mode === 'per-part' ? kommentare.entries : undefined;
const tafel = kommentare ? firstTafelbild(kommentare.entries) : undefined;
const tafelImgSrc = tafel ? (/^(https?:|\/)/.test(tafel.bild) ? tafel.bild : `${base}${tafel.bild}`) : null;
const tafelDeeplink = tafel && tafel.vortrag && tafel.anker ? `${base}${tafel.vortrag}#${tafel.anker}` : null;
---
<Base title={pageTitle} chapter={chapter} number={number} section={section}>
  {props.kind === 'mantra' && (
    <div class={`mantra-shell${tafel ? ' mantra-shell--with-tafel' : ''}`}>
      <div class="mantra-col">
        <MantraView mantra={props.mantra} kommentare={perPartKommentare} />
        {pageKommentar && (
          <KommentarKlappe kommentar={pageKommentar.kommentar} mantraId={props.mantra.id} klappenKey={pageKommentar.key} />
        )}
      </div>
      {tafel && tafelImgSrc && (
        <aside class="tafel-side" aria-label="Wandtafelzeichnung">
          <figure class="tafel-figure">
            {tafelDeeplink ? (
              <a href={tafelDeeplink} class="tafel-link">
                <img src={tafelImgSrc} alt={tafel.beschreibung} loading="lazy" decoding="async" />
              </a>
            ) : (
              <img src={tafelImgSrc} alt={tafel.beschreibung} loading="lazy" decoding="async" />
            )}
            <figcaption class="tafel-caption">{tafel.quelle}</figcaption>
          </figure>
        </aside>
      )}
    </div>
  )}
  {props.kind === 'vortrag' && <LectureView vortrag={props.vortrag} />}

  <nav class="pager">
    {prevHref ? (
      <a class="pager-prev" href={prevHref} data-pager="prev">
        <span class="pager-arrow">←</span>
        <span class="pager-num">{prevLabel}</span>
      </a>
    ) : <span />}

    <a class="pager-home" href={homeHref}>Index</a>

    {nextHref ? (
      <a class="pager-next" href={nextHref} data-pager="next">
        <span class="pager-num">{nextLabel}</span>
        <span class="pager-arrow">→</span>
      </a>
    ) : <span />}
  </nav>
</Base>

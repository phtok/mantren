---
// Digitales Geschenkpapier: Landingpage zum Geburtstag.
// Eigenständige Seite (ohne Base-Layout), damit das Zugangs-Gate hier
// nicht greift und keine Topbar/Navigation das Geschenk verrät.
//
// Kein Geheimwort — Ziehen am roten Band ist die einzige Aktion und
// packt die Mantren-App aus.
import '../styles/global.css';
import { ZUGANG_KEY, ZUGANG_WERT } from '../lib/geschenk';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const fontUrl = `${base}fonts/inclusive-sans.woff2`;
const faviconUrl = `${base}favicon.svg`;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <meta name="robots" content="noindex" />
    <meta name="description" content="Ein Geschenk." />
    <title>Ein Geschenk</title>
    <script is:inline>
      (function () {
        try {
          var pref = localStorage.getItem('theme');
          var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (pref === 'dark' || (!pref && prefersDark)) {
            document.documentElement.classList.add('theme-invert');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="geschenk-body">
    <main class="geschenk" id="geschenk" data-zustand="bereit">
      <script is:inline define:vars={{ zugangKey: ZUGANG_KEY, zugangWert: ZUGANG_WERT }}>
        // Schon ausgepackt: Zustand vor dem ersten Malen umschalten, damit
        // die verschnürte Box bei Wiederbesuch nicht kurz aufblitzt.
        (function () {
          try {
            if (localStorage.getItem(zugangKey) === zugangWert) {
              var el = document.getElementById('geschenk');
              el.setAttribute('data-zustand', 'geoeffnet');
              el.classList.add('geloest', 'sofort');
            }
          } catch (e) {}
        })();
      </script>
      <p class="g-eyebrow">Für Martje</p>

      <section class="g-buehne" id="buehne">
        <div class="paket" id="paket" aria-hidden="false">
          <div class="paket-papier">
            <div class="paket-glanz"></div>
          </div>
          <div class="falte falte-links"></div>
          <div class="falte falte-rechts"></div>
          <div class="band band-v"></div>
          <div class="band band-h"></div>
          <button class="schleife" id="schleife" type="button" aria-label="Am Geschenkband ziehen">
            <svg viewBox="0 0 140 78" aria-hidden="true" focusable="false">
              <defs>
                <linearGradient id="gBand" x1="0" y1="0" x2="1" y2="1">
                  <stop class="g-stop-hell" offset="0%" />
                  <stop class="g-stop-mitte" offset="55%" />
                  <stop class="g-stop-kante" offset="100%" />
                </linearGradient>
                <linearGradient id="gKnoten" x1="0" y1="0" x2="0" y2="1">
                  <stop class="g-stop-mitte" offset="0%" />
                  <stop class="g-stop-kante" offset="100%" />
                </linearGradient>
              </defs>
              <path class="s-tail" d="M70 39 L50 74 L60 71 L65 77 Z" />
              <path class="s-tail" d="M70 39 L90 74 L80 71 L75 77 Z" />
              <path class="s-loop" d="M70 39 C 40 4, 6 10, 15 32 C 20 50, 48 48, 70 39 Z" />
              <path class="s-loop" d="M70 39 C 100 4, 134 10, 125 32 C 120 50, 92 48, 70 39 Z" />
              <path class="s-glanz" d="M68 37 C 48 17, 26 16, 20 29 C 27 24, 46 25, 64 35 Z" />
              <path class="s-glanz" d="M72 37 C 92 17, 114 16, 120 29 C 113 24, 94 25, 76 35 Z" />
              <circle class="s-knoten" cx="70" cy="39" r="9.5" />
              <circle class="s-knoten-glanz" cx="66.5" cy="35.5" r="2.4" />
            </svg>
            <span class="band-zieher" aria-hidden="true"></span>
          </button>
        </div>
        <p class="g-hinweis" id="hinweis" aria-live="polite"></p>
      </section>

      <section class="g-reveal" id="reveal" role="status">
        <svg class="g-funke" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
          <path d="M16 1 C 16.8 9.5 17.5 13.5 26.5 15.5 C 17.5 17.5 16.8 21.5 16 30 C 15.2 21.5 14.5 17.5 5.5 15.5 C 14.5 13.5 15.2 9.5 16 1 Z" />
        </svg>
        <h1 class="g-titel">Herzlichen Glückwunsch<br />zum Geburtstag!</h1>
        <p class="g-text">
          Ausgepackt: <strong>die Mantren</strong> — Rudolf Steiners mantrisches
          Spätwerk als App. Mit allen Stunden, Wandtafeln und Kommentaren,
          für unterwegs und komplett offline.
        </p>
        <a class="g-btn g-btn-gross" id="app-link" href={base}>Mantren öffnen&ensp;→</a>
        <p class="g-klein">
          Tipp: In der App unter ⋯ → „App und Offline“ lässt sie sich
          auf dem Handy installieren — dann ist sie immer dabei.
        </p>
        <p class="g-klein g-von">Von Herzen, Philipp&ensp;♡</p>
      </section>
    </main>

    <script is:inline define:vars={{ zugangWert: ZUGANG_WERT, zugangKey: ZUGANG_KEY }}>
      (function () {
        var root = document.getElementById('geschenk');
        var paket = document.getElementById('paket');
        var schleife = document.getElementById('schleife');
        var hinweis = document.getElementById('hinweis');

        function merkeZugang() {
          try { localStorage.setItem(zugangKey, zugangWert); } catch (e) {}
        }

        // Bereits beim Rendern ausgepackt (siehe Script oben)?
        var ausgepackt = root.getAttribute('data-zustand') === 'geoeffnet';
        if (!ausgepackt) hinweis.textContent = 'Zieh am roten Band.';

        function auspacken() {
          if (ausgepackt) return;
          ausgepackt = true;
          merkeZugang();
          root.classList.add('geloest');
          hinweis.textContent = '';
          setTimeout(function () { root.setAttribute('data-zustand', 'geoeffnet'); }, 1050);
        }

        // ── Band ziehen (Pointer-Drag, Klick/Enter als Fallback) ──
        var startY = null;
        var gezogen = 0;
        var SCHWELLE = 110;

        schleife.addEventListener('pointerdown', function (e) {
          if (root.getAttribute('data-zustand') !== 'bereit') return;
          startY = e.clientY;
          gezogen = 0;
          paket.classList.add('am-ziehen');
          try { schleife.setPointerCapture(e.pointerId); } catch (err) {}
        });
        schleife.addEventListener('pointermove', function (e) {
          if (startY === null) return;
          gezogen = Math.max(0, e.clientY - startY);
          var d = Math.min(gezogen, 150);
          paket.style.setProperty('--zug', d + 'px');
          if (gezogen > SCHWELLE) {
            startY = null;
            paket.classList.remove('am-ziehen');
            auspacken();
          }
        });
        function zugEnde() {
          if (startY === null) return;
          startY = null;
          paket.classList.remove('am-ziehen');
          paket.style.setProperty('--zug', '0px');
        }
        schleife.addEventListener('pointerup', zugEnde);
        schleife.addEventListener('pointercancel', zugEnde);

        // Klick (ohne nennenswerten Zug) bzw. Enter/Leertaste: kurzer
        // Ruck, dann auspacken — damit es auf jedem Gerät klappt.
        schleife.addEventListener('click', function () {
          if (root.getAttribute('data-zustand') !== 'bereit') return;
          if (gezogen > 12) { gezogen = 0; return; }
          paket.style.setProperty('--zug', '60px');
          setTimeout(auspacken, 180);
        });

      })();
    </script>
  </body>
</html>

<style>
  .geschenk-body {
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1.25rem;
    background: radial-gradient(60% 50% at 50% 38%, var(--geschenk-halo), transparent 72%), var(--bg);
    --geschenk-halo: rgba(168, 58, 56, 0.06);
  }
  :global(html.theme-invert) .geschenk-body {
    --geschenk-halo: rgba(181, 82, 74, 0.1);
  }

  .geschenk {
    width: 100%;
    max-width: 26rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    --band-farbe: #a83a38;
    --band-kante: #832d2b;
    --band-hell: #d3695f;
    --papier-1: #f3efe9;
    --papier-2: #e4ded2;
    --papier-dot: #c9c0ae;
  }
  :global(html.theme-invert) .geschenk {
    --band-farbe: #b5524a;
    --band-kante: #7c332e;
    --band-hell: #d98a78;
    --papier-1: #262019;
    --papier-2: #1a150f;
    --papier-dot: #4a4030;
  }

  .g-eyebrow {
    margin: 0 0 1.75rem;
    font-size: 0.9rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* ─────────────── Paket ─────────────── */

  .g-buehne { width: 100%; }

  .paket {
    --zug: 0px;
    position: relative;
    width: min(78vw, 17rem);
    aspect-ratio: 1;
    margin: 0 auto;
    filter: drop-shadow(0 22px 32px rgba(30, 20, 10, 0.16));
  }
  :global(html.theme-invert) .paket {
    filter: drop-shadow(0 22px 36px rgba(0, 0, 0, 0.5));
  }

  .paket-papier {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: 12px;
    background-color: var(--papier-2);
    background-image:
      radial-gradient(var(--papier-dot) 1px, transparent 1.4px),
      linear-gradient(128deg, var(--papier-1), var(--papier-2) 70%);
    background-size: 20px 20px, 100% 100%;
    background-position: 10px 10px, 0 0;
    box-shadow:
      inset 0 0 0 1px rgba(0, 0, 0, 0.06),
      inset 0 1px 0 rgba(255, 255, 255, 0.4);
    transition: opacity 0.5s ease 0.45s, transform 0.5s ease 0.45s;
  }
  :global(html.theme-invert) .paket-papier {
    box-shadow:
      inset 0 0 0 1px rgba(0, 0, 0, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }

  .paket-glanz {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.5), transparent 42%);
    mix-blend-mode: soft-light;
  }
  :global(html.theme-invert) .paket-glanz { opacity: 0.5; }

  /* Gefaltete Papierecken unten — deuten das Einschlagen an */
  .falte {
    position: absolute;
    bottom: -1px;
    width: 1.6rem;
    height: 1.6rem;
    background: linear-gradient(135deg, var(--papier-1), var(--papier-2));
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.08);
    z-index: 1;
    transition: opacity 0.5s ease 0.45s;
  }
  .falte-links {
    left: -1px;
    clip-path: polygon(0 0, 100% 100%, 0 100%);
  }
  .falte-rechts {
    right: -1px;
    clip-path: polygon(100% 0, 100% 100%, 0 100%);
  }

  .band {
    position: absolute;
    z-index: 2;
    box-shadow:
      inset 0 0 0 1px var(--band-kante),
      0 2px 6px rgba(20, 8, 6, 0.22);
    transition: transform 0.6s ease-in 0.15s, opacity 0.6s ease-in 0.15s;
  }
  .band-v {
    top: -4px; bottom: -4px;
    left: 50%;
    width: 1.6rem;
    transform: translateX(-50%);
    background: linear-gradient(90deg, var(--band-hell), var(--band-farbe) 42%, var(--band-kante) 52%, var(--band-farbe) 62%, var(--band-hell) 100%);
  }
  .band-h {
    left: -4px; right: -4px;
    top: 50%;
    height: 1.6rem;
    transform: translateY(-50%);
    background: linear-gradient(180deg, var(--band-hell), var(--band-farbe) 42%, var(--band-kante) 52%, var(--band-farbe) 62%, var(--band-hell) 100%);
  }

  .schleife {
    position: absolute;
    z-index: 3;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -58%);
    width: 9.5rem;
    background: none;
    border: 0;
    padding: 0.5rem;
    cursor: grab;
    touch-action: none;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.45s ease, opacity 0.45s ease;
  }
  .schleife:active { cursor: grabbing; }
  .schleife:focus-visible {
    outline: 2px solid var(--band-farbe);
    outline-offset: 4px;
    border-radius: 8px;
  }
  .schleife svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    filter: drop-shadow(0 6px 10px rgba(20, 8, 6, 0.28));
    transform: translateY(calc(var(--zug) * 0.18)) rotate(calc(var(--zug) / 40 * 1deg));
    transition: transform 0.2s ease;
  }
  .paket.am-ziehen .schleife svg { transition: none; }

  .g-stop-hell { stop-color: var(--band-hell); }
  .g-stop-mitte { stop-color: var(--band-farbe); }
  .g-stop-kante { stop-color: var(--band-kante); }

  .s-loop { fill: url(#gBand); stroke: var(--band-kante); stroke-width: 1.25; stroke-linejoin: round; }
  .s-tail { fill: var(--band-farbe); stroke: var(--band-kante); stroke-width: 1; stroke-linejoin: round; }
  .s-glanz { fill: rgba(255, 255, 255, 0.4); }
  .s-knoten { fill: url(#gKnoten); stroke: var(--band-kante); stroke-width: 1; }
  .s-knoten-glanz { fill: rgba(255, 255, 255, 0.55); }

  /* Herabhängendes Bandende als Zieh-Griff */
  .band-zieher {
    position: absolute;
    left: 50%;
    top: 68%;
    width: 0.95rem;
    height: 4.4rem;
    background: linear-gradient(90deg, var(--band-hell), var(--band-farbe) 45%, var(--band-kante) 55%, var(--band-hell));
    box-shadow: inset 0 0 0 1px var(--band-kante), 0 2px 6px rgba(20, 8, 6, 0.22);
    clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 82%, 0 100%);
    transform: translateX(-50%) translateY(calc(var(--zug) * 0.85)) rotate(3deg);
    transform-origin: top center;
    transition: transform 0.2s ease;
  }
  .paket.am-ziehen .band-zieher { transition: none; }

  /* Sanftes Atmen der Schleife, sobald sie bereit ist */
  [data-zustand='bereit'] .schleife { animation: atmen 2.6s ease-in-out infinite; }
  @keyframes atmen {
    0%, 100% { transform: translate(-50%, -58%) scale(1); }
    50% { transform: translate(-50%, -58%) scale(1.045); }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-zustand='bereit'] .schleife { animation: none; }
  }

  .g-hinweis {
    min-height: 1.4rem;
    margin: 1.5rem 0 0;
    font-size: 0.92rem;
    color: var(--muted);
  }

  /* ─────────────── Auspacken ─────────────── */

  .geloest .schleife {
    opacity: 0;
    transform: translate(-50%, -58%) translateY(2.2rem) scale(0.55) rotate(-14deg);
    animation: none;
    pointer-events: none;
  }
  .geloest .band-v { transform: translateX(-50%) translateY(115%); opacity: 0; }
  .geloest .band-h { transform: translateY(-50%) translateX(120%); opacity: 0; }
  .geloest .paket-papier,
  .geloest .falte { opacity: 0; transform: scale(0.965); }
  .sofort .schleife, .sofort .band, .sofort .paket-papier, .sofort .falte { transition: none; }

  /* ─────────────── Zustände ─────────────── */

  [data-zustand='geoeffnet'] .g-buehne { display: none; }
  [data-zustand='geoeffnet'] .g-reveal { display: block; }

  .g-btn {
    padding: 0.55rem 1rem;
    font: inherit;
    font-size: 0.95rem;
    color: var(--on-petrol);
    background: var(--petrol);
    border: 0;
    border-radius: 8px;
    cursor: pointer;
    text-decoration: none;
    white-space: nowrap;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .g-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 14px rgba(0, 0, 0, 0.14);
  }
  :global(html.theme-invert) .g-btn:hover {
    box-shadow: 0 6px 14px rgba(0, 0, 0, 0.4);
  }

  /* ─────────────── Reveal ─────────────── */

  .g-reveal { display: none; position: relative; animation: aufsteigen 0.7s ease both; }
  @keyframes aufsteigen {
    from { opacity: 0; transform: translateY(0.8rem); }
    to { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .g-reveal { animation: none; }
  }

  .g-funke {
    width: 1.6rem;
    height: 1.6rem;
    margin: 0 auto 0.6rem;
    fill: var(--band-farbe);
    opacity: 0.85;
    animation: funkeln 2.4s ease-in-out infinite;
  }
  @keyframes funkeln {
    0%, 100% { opacity: 0.55; transform: scale(0.92); }
    50% { opacity: 0.95; transform: scale(1.05); }
  }
  @media (prefers-reduced-motion: reduce) {
    .g-funke { animation: none; }
  }

  .g-titel {
    margin: 0.5rem 0 1rem;
    font-size: 1.6rem;
    line-height: 1.25;
    font-weight: 600;
  }
  .g-text {
    margin: 0 0 1.75rem;
    font-size: 1.02rem;
    line-height: 1.6;
    color: var(--text);
  }
  .g-btn-gross {
    display: inline-block;
    padding: 0.75rem 1.4rem;
    font-size: 1.05rem;
  }
  .g-klein {
    margin: 1.4rem 0 0;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--muted);
  }
  .g-von { letter-spacing: 0.02em; }
</style>

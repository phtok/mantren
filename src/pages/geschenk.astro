---
// Digitales Geschenkpapier: Landingpage zum Geburtstag.
// Eigenständige Seite (ohne Base-Layout), damit das Zugangs-Gate hier
// nicht greift und keine Topbar/Navigation das Geschenk verrät.
//
// Ablauf: Geheimwort (Eingabe oder Magic-Link /geschenk/?s=…) löst den
// Knoten → am roten Band ziehen packt aus → die Mantren-App erscheint.
import '../styles/global.css';
import { zugangHash, ZUGANG_KEY } from '../lib/geschenk';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const fontUrl = `${base}fonts/inclusive-sans.woff2`;
const faviconUrl = `${base}favicon.svg`;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <meta name="robots" content="noindex" />
    <meta name="description" content="Ein Geschenk." />
    <title>Ein Geschenk</title>
    <script is:inline>
      (function () {
        try {
          var pref = localStorage.getItem('theme');
          var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (pref === 'dark' || (!pref && prefersDark)) {
            document.documentElement.classList.add('theme-invert');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="geschenk-body">
    <main class="geschenk" id="geschenk" data-zustand="laden">
      <p class="g-eyebrow">Für Martje</p>

      <section class="g-buehne" id="buehne">
        <div class="paket" id="paket" aria-hidden="false">
          <div class="paket-papier"></div>
          <div class="band band-v"></div>
          <div class="band band-h"></div>
          <button class="schleife" id="schleife" type="button" aria-label="Am Geschenkband ziehen">
            <svg viewBox="0 0 120 64" aria-hidden="true" focusable="false">
              <path class="s-loop" d="M60 32 C 34 4, 8 10, 16 28 C 22 42, 46 40, 60 32 Z" />
              <path class="s-loop" d="M60 32 C 86 4, 112 10, 104 28 C 98 42, 74 40, 60 32 Z" />
              <path class="s-tail" d="M60 32 L 44 60 L 52 58 L 56 63 Z" />
              <path class="s-tail" d="M60 32 L 76 60 L 68 58 L 64 63 Z" />
              <circle class="s-knoten" cx="60" cy="32" r="8" />
            </svg>
            <span class="band-zieher" aria-hidden="true"></span>
          </button>
        </div>
        <p class="g-hinweis" id="hinweis" aria-live="polite"></p>
      </section>

      <form class="g-form" id="wortform" autocomplete="off">
        <label class="g-label" for="geheimwort">Dieses Geschenk ist verschnürt. Das Geheimwort löst den Knoten.</label>
        <div class="g-form-zeile">
          <input
            class="g-input"
            id="geheimwort"
            name="geheimwort"
            type="text"
            inputmode="text"
            autocapitalize="off"
            autocorrect="off"
            spellcheck="false"
            placeholder="Geheimwort"
            required
          />
          <button class="g-btn" type="submit">Knoten lösen</button>
        </div>
        <p class="g-fehler" id="fehler" hidden>Das war leider nicht das richtige Wort.</p>
      </form>

      <section class="g-reveal" id="reveal" role="status">
        <h1 class="g-titel">Herzlichen Glückwunsch<br />zum Geburtstag!</h1>
        <p class="g-text">
          Ausgepackt: <strong>die Mantren</strong> — Rudolf Steiners mantrisches
          Spätwerk als App. Mit allen Stunden, Wandtafeln und Kommentaren,
          für unterwegs und komplett offline.
        </p>
        <a class="g-btn g-btn-gross" id="app-link" href={base}>Mantren öffnen&ensp;→</a>
        <p class="g-klein">
          Tipp: In der App unter ⋯ → „App und Offline“ lässt sie sich
          auf dem Handy installieren — dann ist sie immer dabei.
        </p>
        <p class="g-klein g-von">Von Herzen, Philipp</p>
      </section>
    </main>

    <script is:inline define:vars={{ zugangHash, zugangKey: ZUGANG_KEY }}>
      (function () {
        var root = document.getElementById('geschenk');
        var paket = document.getElementById('paket');
        var schleife = document.getElementById('schleife');
        var hinweis = document.getElementById('hinweis');
        var form = document.getElementById('wortform');
        var input = document.getElementById('geheimwort');
        var fehler = document.getElementById('fehler');

        function setZustand(z) {
          root.setAttribute('data-zustand', z);
          if (z === 'bereit') {
            hinweis.textContent = 'Der Knoten ist gelöst — zieh am roten Band.';
          } else if (z === 'verschnuert') {
            hinweis.textContent = '';
          }
        }

        function sha256hex(text) {
          var data = new TextEncoder().encode(text);
          return crypto.subtle.digest('SHA-256', data).then(function (buf) {
            var b = new Uint8Array(buf);
            var out = '';
            for (var i = 0; i < b.length; i++) out += b[i].toString(16).padStart(2, '0');
            return out;
          });
        }

        function pruefeWort(wort) {
          var norm = String(wort || '').trim().toLowerCase();
          if (!norm || !(window.crypto && crypto.subtle)) return Promise.resolve(false);
          return sha256hex(norm).then(function (h) { return h === zugangHash; });
        }

        function merkeZugang() {
          try { localStorage.setItem(zugangKey, zugangHash); } catch (e) {}
        }

        var ausgepackt = false;
        function auspacken() {
          if (ausgepackt) return;
          ausgepackt = true;
          merkeZugang();
          root.classList.add('geloest');
          hinweis.textContent = '';
          setTimeout(function () { setZustand('geoeffnet'); }, 1050);
        }

        // ── Band ziehen (Pointer-Drag, Klick/Enter als Fallback) ──
        var startY = null;
        var gezogen = 0;
        var SCHWELLE = 110;

        schleife.addEventListener('pointerdown', function (e) {
          if (root.getAttribute('data-zustand') !== 'bereit') return;
          startY = e.clientY;
          gezogen = 0;
          paket.classList.add('am-ziehen');
          try { schleife.setPointerCapture(e.pointerId); } catch (err) {}
        });
        schleife.addEventListener('pointermove', function (e) {
          if (startY === null) return;
          gezogen = Math.max(0, e.clientY - startY);
          var d = Math.min(gezogen, 150);
          paket.style.setProperty('--zug', d + 'px');
          if (gezogen > SCHWELLE) {
            startY = null;
            paket.classList.remove('am-ziehen');
            auspacken();
          }
        });
        function zugEnde() {
          if (startY === null) return;
          startY = null;
          paket.classList.remove('am-ziehen');
          paket.style.setProperty('--zug', '0px');
        }
        schleife.addEventListener('pointerup', zugEnde);
        schleife.addEventListener('pointercancel', zugEnde);

        // Klick (ohne nennenswerten Zug) bzw. Enter/Leertaste: kurzer
        // Ruck, dann auspacken — damit es auf jedem Gerät klappt.
        schleife.addEventListener('click', function () {
          if (root.getAttribute('data-zustand') !== 'bereit') return;
          if (gezogen > 12) { gezogen = 0; return; }
          paket.style.setProperty('--zug', '60px');
          setTimeout(auspacken, 180);
        });

        // ── Geheimwort-Eingabe ──
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          pruefeWort(input.value).then(function (ok) {
            if (ok) {
              fehler.hidden = true;
              setZustand('bereit');
              schleife.focus();
            } else {
              fehler.hidden = false;
              form.classList.remove('schuettel');
              void form.offsetWidth;
              form.classList.add('schuettel');
            }
          });
        });

        // ── Startzustand ──
        var gespeichert = null;
        try { gespeichert = localStorage.getItem(zugangKey); } catch (e) {}
        if (gespeichert === zugangHash) {
          // Schon ausgepackt: direkt die Karte zeigen, ohne Animation.
          ausgepackt = true;
          root.classList.add('geloest', 'sofort');
          setZustand('geoeffnet');
        } else {
          var params = new URLSearchParams(location.search);
          var s = params.get('s') || params.get('schluessel') || params.get('code');
          if (s) {
            setZustand('pruefen');
            pruefeWort(s).then(function (ok) {
              if (ok) {
                // Magic-Link: Wort aus der Adresszeile nehmen.
                try { history.replaceState(null, '', location.pathname); } catch (e) {}
                setZustand('bereit');
              } else {
                setZustand('verschnuert');
              }
            });
          } else {
            setZustand('verschnuert');
          }
        }
      })();
    </script>
  </body>
</html>

<style>
  .geschenk-body {
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1.25rem;
  }

  .geschenk {
    width: 100%;
    max-width: 26rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    --band-farbe: #a83a38;
    --band-kante: #8c2f2d;
  }
  :global(html.theme-invert) .geschenk {
    --band-farbe: #b5524a;
    --band-kante: #93413b;
  }

  .g-eyebrow {
    margin: 0 0 1.75rem;
    font-size: 0.9rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* ─────────────── Paket ─────────────── */

  .g-buehne { width: 100%; }

  .paket {
    --zug: 0px;
    position: relative;
    width: min(78vw, 17rem);
    aspect-ratio: 1;
    margin: 0 auto;
  }

  .paket-papier {
    position: absolute;
    inset: 0;
    border-radius: 10px;
    background-color: var(--petrol-soft);
    background-image: radial-gradient(var(--muted-soft) 1px, transparent 1.4px);
    background-size: 20px 20px;
    background-position: 10px 10px;
    box-shadow: inset 0 0 0 1px var(--line);
    transition: opacity 0.5s ease 0.45s, transform 0.5s ease 0.45s;
  }

  .band {
    position: absolute;
    background: var(--band-farbe);
    box-shadow: inset 0 0 0 1px var(--band-kante);
    transition: transform 0.6s ease-in 0.15s, opacity 0.6s ease-in 0.15s;
  }
  .band-v {
    top: -4px; bottom: -4px;
    left: 50%;
    width: 1.6rem;
    transform: translateX(-50%);
  }
  .band-h {
    left: -4px; right: -4px;
    top: 50%;
    height: 1.6rem;
    transform: translateY(-50%);
  }

  .schleife {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -58%);
    width: 9.5rem;
    background: none;
    border: 0;
    padding: 0.5rem;
    cursor: grab;
    touch-action: none;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.45s ease, opacity 0.45s ease;
  }
  .schleife:active { cursor: grabbing; }
  .schleife:focus-visible {
    outline: 2px solid var(--band-farbe);
    outline-offset: 4px;
    border-radius: 8px;
  }
  .schleife svg {
    display: block;
    width: 100%;
    height: auto;
    transform: translateY(calc(var(--zug) * 0.18)) rotate(calc(var(--zug) / 40 * 1deg));
    transition: transform 0.2s ease;
  }
  .paket.am-ziehen .schleife svg { transition: none; }
  .s-loop { fill: var(--band-farbe); stroke: var(--band-kante); stroke-width: 1.5; }
  .s-tail { fill: var(--band-kante); }
  .s-knoten { fill: var(--band-kante); }

  /* Herabhängendes Bandende als Zieh-Griff */
  .band-zieher {
    position: absolute;
    left: 50%;
    top: 68%;
    width: 0.95rem;
    height: 4.4rem;
    background: var(--band-farbe);
    box-shadow: inset 0 0 0 1px var(--band-kante);
    clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 82%, 0 100%);
    transform: translateX(-50%) translateY(calc(var(--zug) * 0.85)) rotate(3deg);
    transform-origin: top center;
    transition: transform 0.2s ease;
  }
  .paket.am-ziehen .band-zieher { transition: none; }

  /* Sanftes Atmen der Schleife, sobald sie bereit ist */
  [data-zustand='bereit'] .schleife { animation: atmen 2.6s ease-in-out infinite; }
  @keyframes atmen {
    0%, 100% { transform: translate(-50%, -58%) scale(1); }
    50% { transform: translate(-50%, -58%) scale(1.045); }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-zustand='bereit'] .schleife { animation: none; }
  }

  .g-hinweis {
    min-height: 1.4rem;
    margin: 1.5rem 0 0;
    font-size: 0.92rem;
    color: var(--muted);
  }

  /* ─────────────── Auspacken ─────────────── */

  .geloest .schleife {
    opacity: 0;
    transform: translate(-50%, -58%) translateY(2.2rem) scale(0.55) rotate(-14deg);
    animation: none;
    pointer-events: none;
  }
  .geloest .band-v { transform: translateX(-50%) translateY(115%); opacity: 0; }
  .geloest .band-h { transform: translateY(-50%) translateX(120%); opacity: 0; }
  .geloest .paket-papier { opacity: 0; transform: scale(0.965); }
  .sofort .schleife, .sofort .band, .sofort .paket-papier { transition: none; }

  /* ─────────────── Zustände ─────────────── */

  .g-form, .g-reveal { display: none; }
  [data-zustand='laden'] .g-buehne { visibility: hidden; }
  [data-zustand='verschnuert'] .g-form { display: block; }
  [data-zustand='geoeffnet'] .g-buehne,
  [data-zustand='geoeffnet'] .g-form { display: none; }
  [data-zustand='geoeffnet'] .g-reveal { display: block; }

  /* ─────────────── Geheimwort-Form ─────────────── */

  .g-form { margin-top: 2rem; width: 100%; }
  .g-label {
    display: block;
    margin-bottom: 0.8rem;
    font-size: 0.95rem;
    color: var(--muted);
    line-height: 1.5;
  }
  .g-form-zeile {
    display: flex;
    gap: 0.5rem;
    justify-content: center;
  }
  .g-input {
    flex: 1;
    min-width: 0;
    max-width: 13rem;
    padding: 0.55rem 0.8rem;
    font: inherit;
    color: var(--text);
    background: var(--input-bg);
    border: 1px solid var(--line);
    border-radius: 8px;
  }
  .g-input:focus { outline: 2px solid var(--petrol); outline-offset: 1px; }
  .g-btn {
    padding: 0.55rem 1rem;
    font: inherit;
    font-size: 0.95rem;
    color: var(--on-petrol);
    background: var(--petrol);
    border: 0;
    border-radius: 8px;
    cursor: pointer;
    text-decoration: none;
    white-space: nowrap;
  }
  .g-fehler {
    margin: 0.8rem 0 0;
    font-size: 0.88rem;
    color: var(--band-farbe);
  }
  .schuettel { animation: schuetteln 0.4s ease; }
  @keyframes schuetteln {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-6px); }
    50% { transform: translateX(6px); }
    75% { transform: translateX(-4px); }
  }

  /* ─────────────── Reveal ─────────────── */

  .g-reveal { animation: aufsteigen 0.7s ease both; }
  @keyframes aufsteigen {
    from { opacity: 0; transform: translateY(0.8rem); }
    to { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .g-reveal { animation: none; }
  }

  .g-titel {
    margin: 0.5rem 0 1rem;
    font-size: 1.6rem;
    line-height: 1.25;
    font-weight: 600;
  }
  .g-text {
    margin: 0 0 1.75rem;
    font-size: 1.02rem;
    line-height: 1.6;
    color: var(--text);
  }
  .g-btn-gross {
    display: inline-block;
    padding: 0.75rem 1.4rem;
    font-size: 1.05rem;
  }
  .g-klein {
    margin: 1.4rem 0 0;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--muted);
  }
  .g-von { letter-spacing: 0.02em; }
</style>

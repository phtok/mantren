---
import Base from '../layouts/Base.astro';
import { chapters, mantren, mantrenByChapter } from '../lib/mantren';
import { vortraege } from '../lib/vortraege';
import { tx } from '../lib/typografie';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const searchIndex = mantren.map((m) => {
  const chapter = chapters.find((c) => c.id === m.chapter);
  const lines: string[] = [];
  for (const part of m.parts) {
    if (part.regie) lines.push(tx(part.regie));
    if (part.section) lines.push(tx(part.section));
    if (part.lines) for (const ln of part.lines) {
      lines.push(tx(ln.startsWith('/') ? ln.slice(1) : ln));
    }
  }
  return {
    href: `${base}${m.id}`,
    number: m.number ?? '',
    title: tx(m.title ?? ''),
    chapter: tx(chapter?.title ?? ''),
    lines,
  };
});

const offlineUrls = [
  base,
  ...mantren.map((m) => `${base}${m.id}`),
  `${base}vortraege`,
  ...vortraege.map((v) => `${base}${v.id}`),
  `${base}quellen`,
  `${base}fonts/inclusive-sans.woff2`,
  `${base}favicon.svg`,
];
---
<Base title="Mantren">
  <div class="index-intro">
    <h1 class="index-title">Mantren</h1>
    <p class="index-subtitle">Rudolf Steiners mantrisches Spätwerk</p>
  </div>

  <label class="search-box">
    <input
      class="search-input"
      type="search"
      id="toc-search"
      placeholder="Suchen — Nummer, Titel, Wort"
      autocomplete="off"
      autocorrect="off"
      spellcheck="false"
    />
  </label>

  <div class="offline-pane" id="offline-pane" aria-live="polite">
    <button class="offline-btn" id="offline-btn" type="button">
      <span class="offline-dot"></span>
      <span class="offline-text">offline laden</span>
    </button>
  </div>

  <div id="search-results" class="search-results" hidden></div>

  <div id="toc">
    {chapters.map((chapter) => {
      const list = mantrenByChapter(chapter.id);
      if (list.length === 0) return null;
      return (
        <section class="toc-chapter" data-chapter-id={chapter.id}>
          <div class="toc-chapter-head">
            <h2 class="toc-chapter-title">{tx(chapter.title)}</h2>
            {chapter.range && <span class="toc-chapter-range">{chapter.range}</span>}
          </div>
          <ul class="toc-list">
            {list.map((m) => (
              <li>
                <a class="toc-link" href={`${base}${m.id}`}>
                  <span class="toc-number">{m.number || ''}</span>
                  {m.title && <span class="toc-title">{tx(m.title)}</span>}
                </a>
              </li>
            ))}
          </ul>
        </section>
      );
    })}
  </div>

  <footer class="index-footer">
    {vortraege.length > 0 && (
      <a class="index-footer-link" href={`${base}vortraege`}>Vorträge der Klassenstunden</a>
    )}
    <a class="index-footer-link" href={`${base}quellen`}>Quellen und editorische Notiz</a>
  </footer>

  <script type="application/json" id="search-data" set:html={JSON.stringify(searchIndex)} />
  <script type="application/json" id="offline-urls" set:html={JSON.stringify(offlineUrls)} />

  <script is:inline>
    (function () {
      var pane = document.getElementById('offline-pane');
      var btn = document.getElementById('offline-btn');
      var btnText = btn && btn.querySelector('.offline-text');
      var urlsEl = document.getElementById('offline-urls');
      if (!pane || !btn || !urlsEl) return;

      var urls = JSON.parse(urlsEl.textContent || '[]');
      var STORAGE_KEY = 'offline-ready-v1';

      function showReady() {
        pane.classList.add('is-ready');
        pane.classList.remove('is-loading');
        btn.disabled = true;
        btnText.textContent = 'offline bereit';
      }

      function showProgress(done, total) {
        pane.classList.add('is-loading');
        pane.classList.remove('is-ready');
        btn.disabled = true;
        btnText.textContent = 'lädt … ' + done + ' / ' + total;
      }

      function showIdle() {
        pane.classList.remove('is-ready', 'is-loading');
        btn.disabled = false;
        btnText.textContent = 'offline laden';
      }

      if (!('serviceWorker' in navigator)) {
        pane.hidden = true;
        return;
      }

      navigator.serviceWorker.getRegistration().then(function (reg) {
        var flag = false;
        try { flag = localStorage.getItem(STORAGE_KEY) === '1'; } catch (e) {}
        if (reg && reg.active && flag) {
          showReady();
        } else {
          showIdle();
        }
      });

      btn.addEventListener('click', function () {
        var total = urls.length;
        showProgress(0, total);
        var batchSize = 6;
        var idx = 0;

        function runBatch() {
          if (idx >= total) {
            try { localStorage.setItem(STORAGE_KEY, '1'); } catch (e) {}
            showReady();
            return;
          }
          var batch = urls.slice(idx, idx + batchSize);
          idx += batch.length;
          Promise.all(batch.map(function (u) {
            return fetch(u, { credentials: 'same-origin' }).catch(function () {});
          })).then(function () {
            var done = idx > total ? total : idx;
            showProgress(done, total);
            runBatch();
          });
        }
        runBatch();
      });
    })();
  </script>

  <script is:inline>
    (function () {
      var input = document.getElementById('toc-search');
      var resultsEl = document.getElementById('search-results');
      var tocEl = document.getElementById('toc');
      var dataEl = document.getElementById('search-data');
      if (!input || !resultsEl || !tocEl || !dataEl) return;

      var data = JSON.parse(dataEl.textContent || '[]');

      function escapeHtml(s) {
        return String(s).replace(/[&<>"']/g, function (c) {
          return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c];
        });
      }

      function highlight(line, ql) {
        var lower = line.toLowerCase();
        var out = '';
        var i = 0;
        while (i <= line.length) {
          var idx = lower.indexOf(ql, i);
          if (idx < 0) { out += escapeHtml(line.slice(i)); break; }
          out += escapeHtml(line.slice(i, idx));
          out += '<mark>' + escapeHtml(line.slice(idx, idx + ql.length)) + '</mark>';
          i = idx + ql.length;
        }
        return out;
      }

      function render(q) {
        if (!q) {
          resultsEl.hidden = true;
          tocEl.hidden = false;
          resultsEl.innerHTML = '';
          return;
        }
        tocEl.hidden = true;
        resultsEl.hidden = false;
        var ql = q.toLowerCase();
        var html = '';
        var mantraCount = 0;
        var hitCount = 0;
        for (var i = 0; i < data.length; i++) {
          var m = data[i];
          var titleMatch = m.title && m.title.toLowerCase().indexOf(ql) >= 0;
          var numberMatch = m.number && m.number.toLowerCase().indexOf(ql) >= 0;
          var matches = [];
          for (var j = 0; j < m.lines.length; j++) {
            if (m.lines[j].toLowerCase().indexOf(ql) >= 0) matches.push(m.lines[j]);
          }
          if (!matches.length && !titleMatch && !numberMatch) continue;
          mantraCount++;
          hitCount += matches.length;
          html += '<a class="result" href="' + escapeHtml(m.href) + '">';
          html += '<div class="result-head">';
          html += '<span class="result-num">' + escapeHtml(m.number) + '</span>';
          var titleHtml = m.title ? (titleMatch ? highlight(m.title, ql) : escapeHtml(m.title)) : '';
          var chapterHtml = escapeHtml(m.chapter);
          if (titleHtml) {
            html += '<span class="result-title">' + titleHtml + '</span>';
            html += '<span class="result-chapter">' + chapterHtml + '</span>';
          } else {
            html += '<span class="result-title result-chapter">' + chapterHtml + '</span>';
          }
          html += '</div>';
          if (matches.length) {
            html += '<div class="result-snippets">';
            for (var k = 0; k < matches.length; k++) {
              html += '<p class="snippet">' + highlight(matches[k], ql) + '</p>';
            }
            html += '</div>';
          }
          html += '</a>';
        }
        if (!html) {
          resultsEl.innerHTML = '<p class="no-results">Keine Treffer.</p>';
        } else {
          var summary = mantraCount + (mantraCount === 1 ? ' Mantra' : ' Mantren');
          if (hitCount > 0) summary += ', ' + hitCount + (hitCount === 1 ? ' Fundstelle' : ' Fundstellen');
          resultsEl.innerHTML = '<p class="result-count">' + summary + '</p>' + html;
        }
      }

      input.addEventListener('input', function (e) {
        render((e.target.value || '').trim());
      });

      input.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') {
          var first = resultsEl.querySelector('a.result') || tocEl.querySelector('a.toc-link');
          if (first) first.click();
        }
        if (e.key === 'Escape') {
          input.value = '';
          render('');
        }
      });
    })();
  </script>
</Base>

---
import Base from '../layouts/Base.astro';
import { tx } from '../lib/typografie';

type Eintrag = {
  begriff: string;
  alternativen?: string[];
  erklaerung: string;
  verweis?: string;
};
type Gruppe = { titel: string; eintraege: Eintrag[] };

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const gruppen: Gruppe[] = [
  {
    titel: 'Werk und Schule',
    eintraege: [
      {
        begriff: 'Klassenstunde',
        erklaerung:
          'Eine der 38 esoterischen Unterweisungen, die Rudolf Steiner zwischen dem 15. Februar und dem 20. September 1924 für die Mitglieder der Ersten Klasse hielt; 30 davon sind durch Nachschriften erhalten.',
      },
      {
        begriff: 'Erste Klasse',
        erklaerung:
          'Die erste der drei vorgesehenen Stufen der Freien Hochschule für Geisteswissenschaft am Goetheanum. Nur sie kam zustande, weil Rudolf Steiner im Herbst 1924 erkrankte und am 30. März 1925 starb.',
      },
      {
        begriff: 'Freie Hochschule für Geisteswissenschaft',
        erklaerung:
          'An der Weihnachtstagung 1923/24 neu konstituierte Einrichtung der Allgemeinen Anthroposophischen Gesellschaft mit Sitz am Goetheanum in Dornach.',
      },
      {
        begriff: 'Mantram',
        alternativen: ['Mantra', 'mantrischer Spruch'],
        erklaerung:
          'Verdichteter, an die Wandtafel geschriebener Wortzusammenhang, der nicht erklärt, sondern in der Wiederholung gelebt werden soll. Massgeblich ist im Allgemeinen der Tafelwortlaut.',
      },
      {
        begriff: 'Tafel, Tafeltext',
        erklaerung:
          'Doppeldeutig: einerseits die drei zusammenfassenden Mantra-Bögen ‹Erste Tafel›, ‹Zweite Tafel›, ‹Dritte Tafel›, die in dieser App eigene Seiten haben; andererseits der an die Wandtafel geschriebene Wortlaut eines einzelnen Spruchs (in den Vorträgen als eigener Abschnittstyp ausgewiesen).',
        verweis: 'erste-tafel',
      },
      {
        begriff: 'Wandtafelzeichnung',
        erklaerung:
          'Die farbigen Kreidezeichnungen, mit denen Steiner die Klassenstunden begleitete. Sie wurden auf schwarzem Papier konserviert und liegen im Tafelband GA 270i vor; eine Auswahl ist in der Wandtafelgalerie versammelt.',
      },
      {
        begriff: 'Wiederholungsstunde',
        erklaerung:
          'Eine von sieben Stunden im September 1924, in denen Steiner die früher gegebenen Mantren noch einmal fasste. Steiner selbst betont: ‹Wiederholung ist hier zugleich Fortsetzung.›',
      },
      {
        begriff: 'Michael, Michael-Zeitalter',
        erklaerung:
          'Seit dem letzten Drittel des 19. Jahrhunderts wirkt der Erzengel Michael nach Steiner als Zeitgeist (Sonnenkräfte). Die Klassenstunden verstehen sich darum als Michael-Schule; Michael-Worte sind alle Worte, Michael-Wille aller Wille.',
      },
      {
        begriff: 'Karma',
        erklaerung:
          'Schicksal als Wirkungszusammenhang vorausliegender Erdenleben. In den Klassenstunden zentral für das Bewusstsein, dass das eigene Tun in den Weltäther eingeschrieben wird und im Zusammenwirken mit den Hierarchien ausgearbeitet werden muss.',
      },
    ],
  },
  {
    titel: 'Figuren der Schwelle',
    eintraege: [
      {
        begriff: 'Weltenwort',
        erklaerung:
          'Das tragende Mantram ‹O Mensch, erkenne dich selbst!›, das dem Menschen aus aller Natur entgegentönt und im weiteren Gang aus dem Mund des Hüters selbst wiederum erklingt — ein und dasselbe Wort, zwei Arten, davon ergriffen zu werden.',
        verweis: 'erste-tafel',
      },
      {
        begriff: 'Hüter der Schwelle',
        erklaerung:
          'Das erste Geistwesen am Abgrund zwischen Sinneswelt und geistiger Welt. Er bewahrt vor unreifem Eintreten und ist zugleich das einzige Tor der Erkenntnis.',
        verweis: '1.2',
      },
      {
        begriff: 'Abgrund, Schwelle',
        erklaerung:
          'Die schwarze, nachtbedeckte Wand zwischen der sonnenbeglänzten Sinneswelt und dem geistigen Sein. Der Mensch im Erdenleben überschreitet sie nicht mit den Sinnen, sondern erst in der Meditation — und nur, wenn die drei Tiere überwunden sind.',
      },
      {
        begriff: 'Geistesbote',
        erklaerung:
          'Das aus der Finsternis aufleuchtende, ‹ernste Geisteswort im Weltenäther›, das vor dem Abgrund erscheint und dem Suchenden den Weg erleuchtet. Sieh, ich bin der Erkenntnis einzig Tor.',
        verweis: '1.2',
      },
      {
        begriff: 'Daseinswort',
        erklaerung:
          'Das aus göttlichen Heileskräften in den Weltgestaltungsmächten wollend wirkende Wort, das in der Sprache der Hierarchien das Weltenwort wiederholt: ‹O, du Mensch, erkenne dich selbst.›',
        verweis: '1.3',
      },
      {
        begriff: 'Die drei Tiere',
        erklaerung:
          'Die drei am Abgrund auftauchenden Erkenntnisfeinde: Furcht im Wollen (erstes Tier), Hass im Fühlen (zweites Tier), Zweifel im Denken (drittes Tier). Erst wenn sie durch Erkenntnismut, Erkenntnisfeuer und Erkenntnisschaffen besiegt sind, wachsen der Seele Flügel.',
        verweis: '1.4',
      },
      {
        begriff: 'Schwellengespräch',
        erklaerung:
          'Der Dialog zwischen Hüter und Ich an den vier Elementen (Erde, Wasser, Luft, Feuer); in den späteren Stunden in drei Stimmen aufgefächert, die je verschieden antworten — Christus, Luzifer, Ahriman.',
        verweis: '14.4',
      },
      {
        begriff: 'Luzifer',
        erklaerung:
          'Im Schwellengespräch die Stimme des Drinnenbleiben-Wollens. Sie möchte das Ich im Geistigen festhalten und nicht in die Erde zurückkehren lassen.',
      },
      {
        begriff: 'Ahriman',
        erklaerung:
          'Im Schwellengespräch die Gegenstimme zu Luzifer. Sie möchte das Ich ins rein Physische herüberreissen und seine geistige Herkunft vergessen machen.',
      },
      {
        begriff: 'Christus',
        erklaerung:
          'Im Schwellengespräch die mittlere, richtende Stimme: Eins-Sein mit der Geistwelt, solange das Ich bei ihr ist, und Rückkehr als rechter Erdenmensch.',
      },
    ],
  },
  {
    titel: 'Hierarchien',
    eintraege: [
      {
        begriff: 'Die drei Hierarchien',
        erklaerung:
          'Drei zu je drei gegliederte Wesensreihen geistiger Wesen, die auf die Fragen des Hüters für die vier Elemente antworten. Dritte Hierarchie (erdverwandt): Angeloi, Archangeloi, Archai — Element Erde. Zweite Hierarchie: Exusiai, Dynamis, Kyriotetes — Element Wasser. Erste Hierarchie: Throne, Cherubine, Seraphine — Element Luft. Das Wärmeelement durchdringt alles und lässt die Stimmen aller drei Hierarchien im Chor antworten.',
      },
    ],
  },
  {
    titel: 'Quellen und Edition',
    eintraege: [
      {
        begriff: 'GA',
        alternativen: ['Gesamtausgabe'],
        erklaerung:
          'Die Rudolf-Steiner-Gesamtausgabe, herausgegeben vom Rudolf Steiner Verlag und der Rudolf Steiner-Nachlassverwaltung in Dornach.',
      },
      {
        begriff: 'GA 270, GA 270a–c',
        erklaerung:
          'Die drei Textbände der Esoterischen Unterweisungen für die Erste Klasse (Manuskriptdruck 1977; durchgesehene 4. Auflage 2020; neu durchgesehene 5. Auflage 2022). a: Stunden 1–9 (Dornach). b: Stunden 10–19 (Dornach). c: Wiederholungsstunden, Prag, Bern, London.',
      },
      {
        begriff: 'GA 270i',
        erklaerung:
          'Der Tafelband mit den Wandtafelzeichnungen und Handschriften zu den Klassenstunden. Quelle der hier gezeigten Tafelbilder.',
      },
      {
        begriff: 'Mantrenbüchlein Basel 2024',
        erklaerung:
          'Lesefassung der Mantren von Bodo von Plato, Elke Schmitter und Anke Steinmetz (Berlin, Februar 2024), für die Mantrenwerkstatt Basel im Mai 2024 in Form gebracht. Primäre Ausgangsbasis dieser Web-App.',
      },
      {
        begriff: 'Faksimile, Klartextnachschrift',
        erklaerung:
          'Bild-PDF einer maschinenschriftlich gereinigten Stenogramm-Übertragung. Der Verlag Rudolf Steiner Ausgaben stellt Helene Finckhs Klartexte zu den 19 Hauptstunden frei zur Verfügung; der Link ist pro Stunde am Fuss der Vortragsseite verlinkt.',
      },
      {
        begriff: 'Stenogramm',
        erklaerung:
          'Die handschriftliche Mitschrift in Kurzschrift, Grundlage aller Textfassungen. Dornach: Helene Finckh. Bern: Rudolf Hahn. Zweite Londoner Stunde: George Adams (Bruchstücke). Breslau (eigenständige Überlieferung): Lilly Kolisko.',
      },
      {
        begriff: 'Helene Finckh',
        erklaerung:
          'Die offizielle Stenographin der Vorträge Rudolf Steiners. Ihre Stenogramme und Klartextnachschriften sind die Textbasis aller GA-270-Bände.',
      },
      {
        begriff: 'Marie Steiner',
        erklaerung:
          'Witwe Rudolf Steiners. Sie rang besonders in ihren letzten Jahren mit der sachgemässen Lösung, wie die nicht zur persönlichen Lektüre gedachten Klassentexte überliefert werden sollten.',
      },
    ],
  },
];
---
<Base title="Glossar">
  <article class="glossar">
    <header class="glossar-head">
      <h1 class="glossar-title">Glossar</h1>
      <p class="glossar-subtitle">Begriffe der Klassenstunden, in der Reihenfolge ihres Auftretens im Werk</p>
    </header>

    {gruppen.map((g) => (
      <section class="glossar-section">
        <h2>{tx(g.titel)}</h2>
        <dl class="glossar-list">
          {g.eintraege.map((e) => (
            <Fragment>
              <dt>
                {tx(e.begriff)}
                {e.alternativen && e.alternativen.length > 0 && (
                  <span class="glossar-alt"> · {tx(e.alternativen.join(', '))}</span>
                )}
              </dt>
              <dd>
                {tx(e.erklaerung)}
                {e.verweis && (
                  <a class="glossar-verweis" href={`${base}${e.verweis}`}>↗ {tx(e.verweis)}</a>
                )}
              </dd>
            </Fragment>
          ))}
        </dl>
      </section>
    ))}

    <p class="vortrag-back">
      <a href={base}>← Zum Mantren-Index</a>
      <span aria-hidden="true"> · </span>
      <a href={`${base}vortraege`}>Vorträge</a>
      <span aria-hidden="true"> · </span>
      <a href={`${base}quellen`}>Quellen</a>
    </p>
  </article>
</Base>

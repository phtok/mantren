---
import Base from '../layouts/Base.astro';
import { tx } from '../lib/typografie';
import quellenRaw from '../data/quellen.json';

type QuelleEintrag = {
  id: string;
  kurztitel?: string;
  titel?: string;
  rolle?: string;
  inhalt?: string;
  textquelle?: string;
  bearbeitung?: string;
  art?: string;
  verlag?: string;
  ort?: string;
  ausgabe?: string;
  in?: string;
  herausgeber?: string;
  textgrundlage?: string;
  verwendet_fuer?: string;
  hinweis?: string;
  rechte?: string;
  status?: string;
  rechtslage_recherchiert?: string;
  veroeffentlichung?: string;
  quell_scan_im_projekt?: string;
  bereitgestellt_von?: string;
  url?: string;
  rechtsstatus?: string;
  isbn?: string;
};
type Werk = {
  titel: string;
  autor: string;
  ga: string;
  gattung: string;
  umfang_gesamt: string;
};
type Lit = { ga: string; titel: string };
type Data = {
  werk: Werk;
  quellen: QuelleEintrag[];
  textgrundlage: Record<string, string>;
  editorische_konventionen_webausgabe: Record<string, string>;
  ueberlieferung: Record<string, string>;
  rechtestatus: Record<string, string>;
  weiterfuehrende_literatur: Lit[];
  klassenstunden_uebersicht: Record<string, string>;
  editorische_beitraege?: Record<string, string>;
  bearbeitung: Record<string, string>;
};
const d = quellenRaw as unknown as Data;

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

type Field = { label: string; key: keyof QuelleEintrag };
const quelleFields: Field[] = [
  { label: 'Rolle', key: 'rolle' },
  { label: 'Inhalt', key: 'inhalt' },
  { label: 'Textquelle', key: 'textquelle' },
  { label: 'In', key: 'in' },
  { label: 'Herausgeber', key: 'herausgeber' },
  { label: 'Bearbeitung', key: 'bearbeitung' },
  { label: 'Art', key: 'art' },
  { label: 'Verlag', key: 'verlag' },
  { label: 'Ort', key: 'ort' },
  { label: 'Ausgabe', key: 'ausgabe' },
  { label: 'ISBN', key: 'isbn' },
  { label: 'Textgrundlage', key: 'textgrundlage' },
  { label: 'Bereitgestellt von', key: 'bereitgestellt_von' },
  { label: 'Verwendet für', key: 'verwendet_fuer' },
  { label: 'Hinweis', key: 'hinweis' },
  { label: 'Rechte', key: 'rechte' },
  { label: 'Rechtsstatus', key: 'rechtsstatus' },
  { label: 'Veröffentlichung', key: 'veroeffentlichung' },
];
---
<Base title="Quellen und editorische Notiz">
  <article class="quellen">
    <header class="quellen-head">
      <h1 class="quellen-title">Quellen und editorische Notiz</h1>
      <p class="quellen-subtitle">Werknachweis, Textgrundlage, editorische Konventionen, Rechtestatus</p>
    </header>

    <section class="quellen-section">
      <h2>Werk</h2>
      <p class="quellen-werk-titel">{tx(d.werk.titel)}</p>
      <p class="quellen-werk-meta">{tx(d.werk.autor)} · {tx(d.werk.gattung)}</p>
      <p>{tx(d.werk.umfang_gesamt)}</p>
    </section>

    {d.editorische_beitraege && (
      <section class="quellen-section">
        <h2>Editorische Beiträge zur Web-Ausgabe</h2>
        {d.editorische_beitraege.titel_der_abschnitte && (
          <p>{tx(d.editorische_beitraege.titel_der_abschnitte)}</p>
        )}
        {d.editorische_beitraege.viergliederung && (
          <p>{tx(d.editorische_beitraege.viergliederung)}</p>
        )}
      </section>
    )}

    <section class="quellen-section">
      <h2>Verwendete Quellen</h2>
      <ul class="quellen-list">
        {d.quellen.map((q) => (
          <li class={`quellen-item${q.status === 'geschuetzt-nicht-freigegeben' ? ' quellen-item--geschuetzt' : ''}`}>
            <p class="quellen-kurztitel">
              {tx(q.kurztitel || q.id)}
              {q.status === 'geschuetzt-nicht-freigegeben' && (
                <span class="quellen-status">geschützt</span>
              )}
            </p>
            {q.titel && <p class="quellen-werk">{tx(q.titel)}</p>}
            <dl class="quellen-detail">
              {quelleFields.map((f) => {
                const v = q[f.key];
                return v ? (
                  <Fragment>
                    <dt>{f.label}</dt>
                    <dd>{tx(String(v))}</dd>
                  </Fragment>
                ) : null;
              })}
              {q.url && (
                <Fragment>
                  <dt>URL</dt>
                  <dd><a href={q.url} target="_blank" rel="noopener noreferrer">{q.url}</a></dd>
                </Fragment>
              )}
              {q.rechtslage_recherchiert && (
                <Fragment>
                  <dt>Rechtsstand</dt>
                  <dd>{tx(q.rechtslage_recherchiert)}</dd>
                </Fragment>
              )}
            </dl>
          </li>
        ))}
      </ul>
    </section>

    <section class="quellen-section">
      <h2>Textgrundlage</h2>
      <dl class="quellen-dl">
        {d.textgrundlage.dornach && <Fragment><dt>Dornach</dt><dd>{tx(d.textgrundlage.dornach)}</dd></Fragment>}
        {d.textgrundlage.bern && <Fragment><dt>Bern</dt><dd>{tx(d.textgrundlage.bern)}</dd></Fragment>}
        {d.textgrundlage.prag && <Fragment><dt>Prag</dt><dd>{tx(d.textgrundlage.prag)}</dd></Fragment>}
        {d.textgrundlage.london_2 && <Fragment><dt>London (zweite Stunde)</dt><dd>{tx(d.textgrundlage.london_2)}</dd></Fragment>}
        {d.textgrundlage.breslau && <Fragment><dt>Breslau</dt><dd>{tx(d.textgrundlage.breslau)}</dd></Fragment>}
        {d.textgrundlage.mantren && <Fragment><dt>Mantra-Wortlaut</dt><dd>{tx(d.textgrundlage.mantren)}</dd></Fragment>}
        {d.textgrundlage.kursiv_konvention && <Fragment><dt>Kursiv-Konvention der GA</dt><dd>{tx(d.textgrundlage.kursiv_konvention)}</dd></Fragment>}
      </dl>
    </section>

    <section class="quellen-section">
      <h2>Editorische Konventionen dieser Web-Ausgabe</h2>
      <dl class="quellen-dl">
        {Object.entries(d.editorische_konventionen_webausgabe).map(([k, v]) => (
          <Fragment>
            <dt>{k.replace(/_/g, ' ')}</dt>
            <dd>{tx(v)}</dd>
          </Fragment>
        ))}
      </dl>
    </section>

    <section class="quellen-section">
      <h2>Klassenstunden-Übersicht</h2>
      <dl class="quellen-dl">
        {Object.entries(d.klassenstunden_uebersicht).map(([k, v]) => (
          <Fragment>
            <dt>{k.replace(/_/g, ' ')}</dt>
            <dd>{tx(v)}</dd>
          </Fragment>
        ))}
      </dl>
    </section>

    <section class="quellen-section">
      <h2>Zur Überlieferung</h2>
      {Object.values(d.ueberlieferung).map((v) => <p>{tx(v)}</p>)}
    </section>

    <section class="quellen-section">
      <h2>Rechtestatus</h2>
      {Object.values(d.rechtestatus).map((v, i) => (
        <p class={i === 0 ? '' : 'quellen-disclaim'}>{tx(v)}</p>
      ))}
    </section>

    <section class="quellen-section">
      <h2>Weiterführende Literatur</h2>
      <ul class="quellen-lit">
        {d.weiterfuehrende_literatur.map((l) => (
          <li><span class="quellen-lit-ga">GA {tx(l.ga)}</span> {tx(l.titel)}</li>
        ))}
      </ul>
    </section>

    {d.bearbeitung && (
      <section class="quellen-section">
        <h2>Bearbeitungsstand</h2>
        {d.bearbeitung.stand && <p>{tx(d.bearbeitung.stand)}</p>}
        {d.bearbeitung.projekt && (
          <p class="quellen-disclaim">Projekt: <a href={d.bearbeitung.projekt}>{tx(d.bearbeitung.projekt)}</a></p>
        )}
      </section>
    )}

    <p class="vortrag-back">
      <a href={base}>← Zum Mantren-Index</a>
      <span aria-hidden="true"> · </span>
      <a href={`${base}vortraege`}>Vorträge</a>
      <span aria-hidden="true"> · </span>
      <a href={`${base}tafeln-galerie`}>Wandtafelgalerie</a>
      <span aria-hidden="true"> · </span>
      <a href={`${base}glossar`}>Glossar</a>
    </p>
  </article>
</Base>

---
import '../styles/global.css';
import { tx } from '../lib/typografie';
import { buildOfflineUrls } from '../lib/offline';
import { FR_BACKEND } from '../lib/fr-backend';

interface Props {
  title?: string;
  description?: string;
  center?: boolean;
  chapter?: string;
  number?: string;
  section?: string;
}

const rawProps = Astro.props;
const title = tx(rawProps.title ?? 'Mantren');
const description = tx(rawProps.description ?? 'Rudolf Steiners mantrisches Spätwerk');
const center = rawProps.center ?? false;
const chapter = rawProps.chapter ? tx(rawProps.chapter) : undefined;
const number = rawProps.number;
const section = rawProps.section ? tx(rawProps.section) : undefined;
const fullTitle = title === 'Mantren' ? title : `${title} – Mantren`;

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const fontUrl = `${base}fonts/inclusive-sans.woff2`;
const faviconUrl = `${base}favicon.svg`;
const manifestUrl = `${base}manifest.webmanifest`;
const homeUrl = base;
const offlineUrls = buildOfflineUrls(base);
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <link rel="manifest" href={manifestUrl} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Mantren" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="description" content={description} />
    <meta name="robots" content="noai, noimageai" />
    <title>{fullTitle}</title>
    <script is:inline define:vars={{ swUrl: `${base}sw.js`, swScope: base }}>
      // Service-Worker-Registrierung explizit hier — die @vite-pwa/astro-
      // Integration hat das injectRegister-Snippet bei uns nicht in die
      // HTML-Seiten eingebaut (verifiziert via /offline-status/ auf iOS).
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register(swUrl, { scope: swScope }).catch(function (err) {
            // Stillschweigend tolerieren — Diagnose-Seite zeigt es ohnehin.
            try { console.warn('SW register failed:', err); } catch (e) {}
          });
        });
      }
    </script>
    <script is:inline>
      (function () {
        try {
          var pref = localStorage.getItem('theme');
          var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (pref === 'dark' || (!pref && prefersDark)) {
            document.documentElement.classList.add('theme-invert');
          }
        } catch (e) {}
        try {
          var tafelPref = localStorage.getItem('mantren:tafel-vis');
          if (tafelPref === 'hidden') {
            document.documentElement.setAttribute('data-tafel-pref', 'hidden');
          }
        } catch (e) {}
        try {
          if (localStorage.getItem('edition') === 'plex') {
            document.documentElement.setAttribute('data-edition', 'plex');
          }
        } catch (e) {}
        try {
          if (localStorage.getItem('lang') === 'fr') {
            document.documentElement.setAttribute('data-lang', 'fr');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <header class="topbar" id="topbar">
      {chapter ? (
        <a class="topbar-meta-link" href={homeUrl} aria-label="Zum Index">
          <span class="topbar-line1">
            <span class="topbar-site">Mantren</span>
            {number && <span class="topbar-num">{number}</span>}
          </span>
          <span class="topbar-chapter">{chapter}</span>
          {section && <span class="topbar-section">{section}</span>}
        </a>
      ) : (
        <a class="topbar-title" href={homeUrl}>Mantren</a>
      )}
      <div class="topbar-actions">
        <details class="topbar-menu" id="topbar-menu">
          <summary class="icon-btn topbar-menu-summary" title="Einstellungen" aria-label="Einstellungen">⋯</summary>
          <div class="topbar-menu-panel" role="menu">
            <button
              class="topbar-menu-item"
              id="theme-toggle"
              type="button"
              role="menuitemcheckbox"
              aria-checked="false"
            >
              <span class="topbar-menu-icon" aria-hidden="true">◐</span>
              <span class="topbar-menu-label" data-theme-label>Dunkler Modus</span>
            </button>
            <button
              class="topbar-menu-item"
              id="edition-toggle"
              type="button"
              role="menuitemcheckbox"
              aria-checked="false"
            >
              <span class="topbar-menu-icon" aria-hidden="true">⇄</span>
              <span class="topbar-menu-label" data-edition-label>Schriftbild: Plex</span>
            </button>
            <button
              class="topbar-menu-item"
              id="lang-toggle"
              type="button"
              role="menuitemcheckbox"
              aria-checked="false"
            >
              <span class="topbar-menu-icon" aria-hidden="true">⇔</span>
              <span class="topbar-menu-label" data-lang-label>Französisch</span>
            </button>
            <a class="topbar-menu-item" href={`${base}offline/`} role="menuitem">
              <span class="topbar-menu-icon" aria-hidden="true">◌</span>
              <span class="topbar-menu-label">App und Offline</span>
            </a>
          </div>
        </details>
      </div>
    </header>

    <script type="application/json" id="offline-urls" set:html={JSON.stringify(offlineUrls)} />

    <main class={center ? 'center' : ''}>
      <slot />
    </main>

    <dialog id="tafel-fullscreen" class="tafel-fullscreen" aria-label="Wandtafelzeichnung vergrößert">
      <button type="button" class="tafel-fullscreen-close" aria-label="Schließen">×</button>
      <img alt="" />
    </dialog>

    <dialog id="source-fullscreen" class="source-fullscreen" aria-label="Quelle">
      <header class="source-fullscreen-head">
        <div class="source-fullscreen-titles">
          <p class="source-fullscreen-eyebrow" data-source-eyebrow></p>
          <h2 class="source-fullscreen-title" data-source-title></h2>
          <p class="source-fullscreen-meta" data-source-meta></p>
        </div>
        <button type="button" class="source-fullscreen-close" aria-label="Schließen">×</button>
      </header>
      <div class="source-fullscreen-body" data-source-body>
        <p class="source-fullscreen-loading">Lädt …</p>
      </div>
      <footer class="source-fullscreen-foot">
        <a class="source-fullscreen-open" data-source-open href="#">Ganzen Vortrag öffnen →</a>
      </footer>
    </dialog>

    <script is:inline>
      (function () {
        var html = document.documentElement;
        var body = document.body;

        var themeBtn = document.getElementById('theme-toggle');
        var themeLabel = themeBtn && themeBtn.querySelector('[data-theme-label]');
        function refreshThemeLabel() {
          if (!themeBtn) return;
          var isDark = html.classList.contains('theme-invert');
          themeBtn.setAttribute('aria-checked', isDark ? 'true' : 'false');
          if (themeLabel) themeLabel.textContent = isDark ? 'Heller Modus' : 'Dunkler Modus';
        }
        if (themeBtn) {
          refreshThemeLabel();
          themeBtn.addEventListener('click', function () {
            html.classList.toggle('theme-invert');
            try { localStorage.setItem('theme', html.classList.contains('theme-invert') ? 'dark' : 'light'); } catch (e) {}
            refreshThemeLabel();
          });
        }

        var editionBtn = document.getElementById('edition-toggle');
        var editionLabel = editionBtn && editionBtn.querySelector('[data-edition-label]');
        function refreshEditionLabel() {
          if (!editionBtn) return;
          var isPlex = html.getAttribute('data-edition') === 'plex';
          editionBtn.setAttribute('aria-checked', isPlex ? 'true' : 'false');
          if (editionLabel) editionLabel.textContent = isPlex ? 'Schriftbild: Standard' : 'Schriftbild: Plex';
        }
        if (editionBtn) {
          refreshEditionLabel();
          editionBtn.addEventListener('click', function () {
            var isPlex = html.getAttribute('data-edition') === 'plex';
            if (isPlex) { html.removeAttribute('data-edition'); }
            else { html.setAttribute('data-edition', 'plex'); }
            try { localStorage.setItem('edition', isPlex ? 'default' : 'plex'); } catch (e) {}
            refreshEditionLabel();
          });
        }

        // Französisch-Umschalter: schaltet die synoptische Ansicht (Original +
        // Übersetzung) auf allen Mantra-Seiten frei. Reine Anzeige-Umschaltung
        // über html[data-lang="fr"]; die Übersetzungen stecken bereits im HTML.
        var langBtn = document.getElementById('lang-toggle');
        var langLabel = langBtn && langBtn.querySelector('[data-lang-label]');
        function refreshLangLabel() {
          if (!langBtn) return;
          var isFr = html.getAttribute('data-lang') === 'fr';
          langBtn.setAttribute('aria-checked', isFr ? 'true' : 'false');
          if (langLabel) langLabel.textContent = isFr ? 'Nur Deutsch' : 'Französisch';
        }
        if (langBtn) {
          refreshLangLabel();
          langBtn.addEventListener('click', function () {
            var isFr = html.getAttribute('data-lang') === 'fr';
            if (isFr) { html.removeAttribute('data-lang'); }
            else { html.setAttribute('data-lang', 'fr'); }
            try { localStorage.setItem('lang', isFr ? 'de' : 'fr'); } catch (e) {}
            refreshLangLabel();
          });
        }

        // Notizfunktion (fr-Modus): pro Mantra eine lokale Notiz in
        // localStorage; Export/Import als JSON zur Weitergabe. Bewusst ohne
        // Server — reine Ablage, kein Editor.
        (function () {
          var toggle = document.querySelector('.fr-note-toggle');
          if (!toggle) return;
          var id = toggle.getAttribute('data-fr-note');
          var panel = document.querySelector('.fr-note-panel[data-fr-note-panel="' + (window.CSS && CSS.escape ? CSS.escape(id) : id) + '"]');
          var text = panel && panel.querySelector('.fr-note-text');
          var status = panel && panel.querySelector('[data-fr-note-status]');
          var PREFIX = 'mantren:fr-note:';
          var key = PREFIX + id;

          function read(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }
          function markHas() {
            var has = !!(read(key) || '').trim();
            toggle.setAttribute('data-has-note', has ? 'true' : 'false');
          }
          // Initial füllen
          if (text) { var v = read(key); if (v != null) text.value = v; }
          markHas();

          toggle.addEventListener('click', function () {
            var open = panel.getAttribute('data-open') === 'true';
            panel.setAttribute('data-open', open ? 'false' : 'true');
            toggle.setAttribute('aria-expanded', open ? 'false' : 'true');
            if (!open && text) text.focus();
          });

          if (text) {
            var t = null;
            text.addEventListener('input', function () {
              if (t) clearTimeout(t);
              t = setTimeout(function () {
                try {
                  var val = text.value;
                  if (val.trim()) localStorage.setItem(key, val); else localStorage.removeItem(key);
                  if (status) { status.textContent = 'Gespeichert'; setTimeout(function () { if (status) status.textContent = ''; }, 1500); }
                } catch (e) { if (status) status.textContent = 'Speichern fehlgeschlagen'; }
                markHas();
              }, 300);
            });
          }

          function allNotes() {
            var out = {};
            try {
              for (var i = 0; i < localStorage.length; i++) {
                var k = localStorage.key(i);
                if (k && k.indexOf(PREFIX) === 0) out[k.slice(PREFIX.length)] = localStorage.getItem(k);
              }
            } catch (e) {}
            return out;
          }

          var expBtn = panel.querySelector('[data-fr-note-export]');
          if (expBtn) expBtn.addEventListener('click', function () {
            var data = { _typ: 'mantren-fr-notizen', exportiert: new Date().toISOString(), notizen: allNotes() };
            var blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
            var url = URL.createObjectURL(blob);
            var a = document.createElement('a');
            a.href = url; a.download = 'mantren-notizen-fr.json';
            document.body.appendChild(a); a.click(); document.body.removeChild(a);
            setTimeout(function () { URL.revokeObjectURL(url); }, 1000);
          });

          var impBtn = panel.querySelector('[data-fr-note-import]');
          if (impBtn) impBtn.addEventListener('click', function () {
            var inp = document.createElement('input');
            inp.type = 'file'; inp.accept = 'application/json,.json';
            inp.addEventListener('change', function () {
              var f = inp.files && inp.files[0]; if (!f) return;
              var r = new FileReader();
              r.onload = function () {
                try {
                  var parsed = JSON.parse(String(r.result));
                  var notes = parsed && parsed.notizen ? parsed.notizen : parsed;
                  var n = 0;
                  for (var k in notes) { if (Object.prototype.hasOwnProperty.call(notes, k) && typeof notes[k] === 'string') { localStorage.setItem(PREFIX + k, notes[k]); n++; } }
                  if (text) { var cur = read(key); if (cur != null) text.value = cur; }
                  markHas();
                  if (status) { status.textContent = n + ' Notiz(en) importiert'; setTimeout(function () { if (status) status.textContent = ''; }, 2500); }
                } catch (e) { if (status) status.textContent = 'Import fehlgeschlagen'; }
              };
              r.readAsText(f);
            });
            inp.click();
          });
        })();

        // Topbar-Menü: Klick außerhalb schließt die details-Klappe
        var menu = document.getElementById('topbar-menu');
        if (menu) {
          document.addEventListener('click', function (e) {
            if (!menu.open) return;
            var t = e.target;
            if (t instanceof Node && menu.contains(t)) return;
            menu.open = false;
          });
        }

        // Offline-Vorladen, Status- und Diagnose-Logik wohnen ab jetzt
        // ausschließlich auf /offline/ (in der Topbar-Klappe verlinkt).
        // Die URL-Liste #offline-urls steht hier global zur Verfügung,
        // damit die App-Seite sie nutzen kann, ohne sie nochmal zu bauen.

        // Topbar bei Runterscrollen ausblenden, bei Hochscrollen wieder zeigen
        var topbar = document.getElementById('topbar');
        if (topbar) {
          var lastY = window.scrollY;
          var ticking = false;
          var update = function () {
            var y = window.scrollY;
            var dy = y - lastY;
            if (y < 96) {
              topbar.classList.remove('topbar-hidden');
            } else if (dy > 4) {
              topbar.classList.add('topbar-hidden');
            } else if (dy < -4) {
              topbar.classList.remove('topbar-hidden');
            }
            lastY = y;
            ticking = false;
          };
          window.addEventListener('scroll', function () {
            if (!ticking) {
              window.requestAnimationFrame(update);
              ticking = true;
            }
          }, { passive: true });
        }

        // Pager fährt vom unteren Bildschirmrand ein, sobald man am Doku-Ende ist
        var pager = document.querySelector('.pager');
        if (pager) {
          var updatePager = function () {
            var atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 16;
            pager.classList.toggle('pager-visible', atBottom);
          };
          updatePager();
          window.addEventListener('scroll', updatePager, { passive: true });
          window.addEventListener('resize', updatePager);
        }

        document.addEventListener('keydown', function (e) {
          if (e.target instanceof HTMLElement) {
            var tag = e.target.tagName;
            if (tag === 'INPUT' || tag === 'TEXTAREA' || e.target.isContentEditable) return;
          }
          var dlg = document.getElementById('tafel-fullscreen');
          if (dlg && dlg.hasAttribute('open')) return;
          var sdlg = document.getElementById('source-fullscreen');
          if (sdlg && sdlg.hasAttribute('open')) return;
          var prev = document.querySelector('a[data-pager="prev"]');
          var next = document.querySelector('a[data-pager="next"]');
          if (e.key === 'ArrowLeft' && prev) { e.preventDefault(); prev.click(); }
          if (e.key === 'ArrowRight' && next) { e.preventDefault(); next.click(); }
        });

        // Tafelbild-Fullscreen
        (function () {
          var dialog = document.getElementById('tafel-fullscreen');
          if (!dialog) return;
          var dlgImg = dialog.querySelector('img');
          var closeBtn = dialog.querySelector('.tafel-fullscreen-close');

          function openTafel(trigger) {
            var img = trigger.querySelector('img');
            if (!img || !dlgImg) return;
            dlgImg.src = img.currentSrc || img.src;
            dlgImg.alt = img.alt || '';
            if (typeof dialog.showModal === 'function') dialog.showModal();
            else dialog.setAttribute('open', '');
          }

          function closeTafel() {
            if (typeof dialog.close === 'function') dialog.close();
            else dialog.removeAttribute('open');
          }

          document.addEventListener('click', function (e) {
            var t = e.target;
            if (!(t instanceof Element)) return;
            var trigger = t.closest('.js-tafel-trigger');
            if (!trigger) return;
            e.preventDefault();
            openTafel(trigger);
          });

          // Wandtafel-Seitenleiste ein-/ausblenden (Desktop)
          document.addEventListener('click', function (e) {
            var t = e.target;
            if (!(t instanceof Element)) return;
            var btn = t.closest('.js-tafel-vis-toggle');
            if (!btn) return;
            var hide = html.getAttribute('data-tafel-pref') !== 'hidden';
            if (hide) html.setAttribute('data-tafel-pref', 'hidden');
            else html.removeAttribute('data-tafel-pref');
            try { localStorage.setItem('mantren:tafel-vis', hide ? 'hidden' : 'visible'); } catch (e2) {}
          });

          if (closeBtn) closeBtn.addEventListener('click', closeTafel);

          // Klick auf den schwarzen Hintergrund (Dialog selbst) schließt;
          // Klick auf img/Buttons/Link bubbelt nicht zu dieser Bedingung durch.
          dialog.addEventListener('click', function (e) {
            if (e.target === dialog) closeTafel();
          });
        })();

        // Quellen-Overlay: lädt den Vortrag asynchron, zeigt den Abschnitt
        // um den Anker plus etwas Folgekontext. X schließt; iOS-Rückkehr
        // ohne Browser-Verlauf.
        (function () {
          var dialog = document.getElementById('source-fullscreen');
          if (!dialog) return;
          var body = dialog.querySelector('[data-source-body]');
          var eyebrowEl = dialog.querySelector('[data-source-eyebrow]');
          var titleEl = dialog.querySelector('[data-source-title]');
          var metaEl = dialog.querySelector('[data-source-meta]');
          var openLink = dialog.querySelector('[data-source-open]');
          var closeBtn = dialog.querySelector('.source-fullscreen-close');

          var cache = Object.create(null);

          function show() {
            if (typeof dialog.showModal === 'function') {
              try { dialog.showModal(); } catch (e) { dialog.setAttribute('open', ''); }
            } else dialog.setAttribute('open', '');
            try { body.scrollTop = 0; } catch (e) {}
          }
          function close() {
            if (typeof dialog.close === 'function') {
              try { dialog.close(); } catch (e) { dialog.removeAttribute('open'); }
            } else dialog.removeAttribute('open');
          }

          function fetchDoc(url) {
            if (cache[url]) return Promise.resolve(cache[url]);
            return fetch(url, { credentials: 'same-origin' })
              .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.text(); })
              .then(function (html) {
                var doc = new DOMParser().parseFromString(html, 'text/html');
                cache[url] = doc;
                return doc;
              });
          }

          function render(url, anker) {
            body.innerHTML = '<p class="source-fullscreen-loading">Lädt …</p>';
            eyebrowEl.textContent = '';
            titleEl.textContent = '';
            metaEl.textContent = '';
            if (openLink) openLink.setAttribute('href', anker ? (url + '#' + anker) : url);
            show();

            fetchDoc(url).then(function (doc) {
              // Kopfdaten aus der Vortragsseite
              var head = doc.querySelector('.vortrag-head');
              if (head) {
                var t = head.querySelector('.vortrag-titel');
                var m = head.querySelector('.vortrag-meta');
                if (t) titleEl.textContent = t.textContent || '';
                if (m) metaEl.textContent = (m.textContent || '').replace(/\s+/g, ' ').trim();
              }
              eyebrowEl.textContent = 'Quelle';

              // Abschnitt am Anker + bis zu zwei folgende Abschnitte als Kontext
              var section = anker ? doc.getElementById(anker) : null;
              var frag = document.createDocumentFragment();
              if (section) {
                var node = section;
                var taken = 0;
                while (node && taken < 3) {
                  frag.appendChild(node.cloneNode(true));
                  // Nächsten Geschwister-Abschnitt finden
                  node = node.nextElementSibling;
                  while (node && !node.matches('.abschnitt')) node = node.nextElementSibling;
                  taken++;
                }
              } else {
                // Fallback: ersten Abschnitt
                var first = doc.querySelector('.vortrag-body .abschnitt');
                if (first) frag.appendChild(first.cloneNode(true));
              }
              body.innerHTML = '';
              if (frag.childNodes.length === 0) {
                body.innerHTML = '<p class="source-fullscreen-loading">Quelle nicht gefunden.</p>';
              } else {
                var wrapper = document.createElement('div');
                wrapper.className = 'source-fullscreen-vortrag';
                wrapper.appendChild(frag);
                body.appendChild(wrapper);
              }
            }).catch(function () {
              body.innerHTML = '<p class="source-fullscreen-loading">Konnte Quelle nicht laden.</p>';
            });
          }

          document.addEventListener('click', function (e) {
            var t = e.target;
            if (!(t instanceof Element)) return;
            var link = t.closest('a[data-source-link]');
            if (!link) return;
            var href = link.getAttribute('href');
            if (!href) return;
            // Externe Links bzw. neue Tabs werden nicht abgefangen
            if (e.metaKey || e.ctrlKey || e.shiftKey || e.button === 1) return;
            if (link.target === '_blank') return;

            // Auflösen relativ zur aktuellen Seite
            var url;
            try { url = new URL(href, window.location.href); } catch (err) { return; }
            // Nur eigene Origin
            if (url.origin !== window.location.origin) return;

            var anker = (url.hash || '').replace(/^#/, '');
            var pageUrl = url.origin + url.pathname + url.search;

            e.preventDefault();
            render(pageUrl, anker || null);
          });

          if (closeBtn) closeBtn.addEventListener('click', close);
          dialog.addEventListener('click', function (e) {
            if (e.target === dialog) close();
          });
          dialog.addEventListener('cancel', function () { close(); });
        })();

        // Wischen links/rechts blättert wie eine Buchseite
        var touchStart = null;
        document.addEventListener('touchstart', function (e) {
          if (e.touches.length !== 1) { touchStart = null; return; }
          touchStart = {
            x: e.touches[0].clientX,
            y: e.touches[0].clientY,
            t: Date.now(),
          };
        }, { passive: true });

        document.addEventListener('touchend', function (e) {
          if (!touchStart) return;
          var t = e.changedTouches[0];
          var dx = t.clientX - touchStart.x;
          var dy = t.clientY - touchStart.y;
          var dt = Date.now() - touchStart.t;
          touchStart = null;
          if (dt > 700) return;
          if (Math.abs(dx) < 60) return;
          if (Math.abs(dy) > Math.abs(dx) * 0.6) return;
          var prev = document.querySelector('a[data-pager="prev"]');
          var next = document.querySelector('a[data-pager="next"]');
          if (dx > 0 && prev) prev.click();
          else if (dx < 0 && next) next.click();
        }, { passive: true });
      })();
    </script>
    <script is:inline define:vars={{ FR_BACKEND }}>
      // Editierbare französische Übersetzung (Supabase).
      // 1) Overlay: im fr-Modus die aktuelle DB-Fassung über die statische legen.
      // 2) Editor: nur mit ?edit=<token> — Louis bearbeitet direkt seine Fassung.
      (function () {
        var art = document.querySelector('.mantra[data-mantra-id]');
        if (!art) return;
        var id = art.getAttribute('data-mantra-id');
        var cfg = FR_BACKEND;
        var synopsis = art.querySelector('.mantra-synopsis');
        if (!synopsis) return;

        function ensureBloc() {
          var b = art.querySelector('.mantra-fr-bloc');
          if (!b) {
            b = document.createElement('aside');
            b.className = 'mantra-fr-bloc';
            b.setAttribute('lang', 'fr');
            b.setAttribute('aria-hidden', 'true');
            synopsis.appendChild(b);
          }
          return b;
        }
        function renderBloc(lines) {
          art.setAttribute('data-fr-mode', 'bloc');
          var b = ensureBloc();
          b.innerHTML = '';
          lines.forEach(function (l) {
            var s = document.createElement('span');
            if (l === '') { s.className = 'ue-spacer'; s.setAttribute('aria-hidden', 'true'); }
            else { s.className = 'line'; s.textContent = l; }
            b.appendChild(s);
          });
        }

        var srcEl = art.querySelector('script.fr-src');
        var currentLines = [];
        try { currentLines = JSON.parse((srcEl && srcEl.textContent) || '[]'); } catch (e) {}

        // 1) Overlay
        var restUrl = cfg.url + '/rest/v1/' + cfg.table + '?mantra_id=eq.' + encodeURIComponent(id) + '&select=fassung';
        fetch(restUrl, { headers: { apikey: cfg.anon, Authorization: 'Bearer ' + cfg.anon } })
          .then(function (r) { return r.ok ? r.json() : []; })
          .then(function (rows) {
            if (rows && rows[0] && rows[0].fassung && Array.isArray(rows[0].fassung.bloc)) {
              currentLines = rows[0].fassung.bloc;
              renderBloc(currentLines);
            }
          })
          .catch(function () {});

        // 2) Editor
        var token = null;
        try { token = new URLSearchParams(location.search).get('edit'); } catch (e) {}
        if (!token) return;
        document.documentElement.setAttribute('data-lang', 'fr');

        var ed = document.createElement('div');
        ed.className = 'fr-editor';
        var head = document.createElement('p');
        head.className = 'fr-editor-head';
        head.textContent = 'Bearbeiten · ' + id;
        var area = document.createElement('textarea');
        area.className = 'fr-editor-area';
        area.setAttribute('spellcheck', 'false');
        area.setAttribute('aria-label', 'Übersetzung bearbeiten');
        var bar = document.createElement('div');
        bar.className = 'fr-editor-bar';
        var save = document.createElement('button');
        save.type = 'button'; save.className = 'fr-editor-save'; save.textContent = 'Speichern';
        var status = document.createElement('span');
        status.className = 'fr-editor-status'; status.setAttribute('aria-live', 'polite');
        var hint = document.createElement('span');
        hint.className = 'fr-editor-hint'; hint.textContent = 'Leerzeile = Strophenabstand';
        bar.appendChild(save); bar.appendChild(status); bar.appendChild(hint);
        ed.appendChild(head); ed.appendChild(area); ed.appendChild(bar);
        art.insertBefore(ed, synopsis);
        area.value = currentLines.join('\n');

        save.addEventListener('click', function () {
          var lines = area.value.replace(/\r/g, '').split('\n');
          while (lines.length && !lines[lines.length - 1].trim()) lines.pop();
          save.disabled = true; status.textContent = 'Speichere …';
          fetch(cfg.url + '/rest/v1/rpc/' + cfg.rpc, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', apikey: cfg.anon, Authorization: 'Bearer ' + cfg.anon },
            body: JSON.stringify({ p_token: token, p_mantra_id: id, p_lines: lines })
          })
            .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
            .then(function (res) {
              save.disabled = false;
              if (res.ok && res.j && res.j.ok) {
                currentLines = lines; renderBloc(lines);
                status.textContent = 'Gespeichert';
              } else {
                status.textContent = 'Fehler: ' + ((res.j && res.j.error) || 'unbekannt');
              }
            })
            .catch(function () { save.disabled = false; status.textContent = 'Netzwerkfehler'; });
        });
      })();
    </script>
  </body>
</html>

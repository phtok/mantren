---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  center?: boolean;
  chapter?: string;
  number?: string;
}

const { title = 'Mantren', description = 'Rudolf Steiners mantrisches Spätwerk', center = false, chapter, number } = Astro.props;
const fullTitle = title === 'Mantren' ? title : `${title} – Mantren`;

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const fontUrl = `${base}fonts/inclusive-sans.woff2`;
const faviconUrl = `${base}favicon.svg`;
const manifestUrl = `${base}manifest.webmanifest`;
const homeUrl = base;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <link rel="manifest" href={manifestUrl} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#101418" media="(prefers-color-scheme: dark)" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Mantren" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="description" content={description} />
    <meta name="robots" content="noai, noimageai" />
    <title>{fullTitle}</title>
    <script is:inline>
      (function () {
        try {
          var pref = localStorage.getItem('theme');
          var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (pref === 'dark' || (!pref && prefersDark)) {
            document.documentElement.classList.add('theme-invert');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <header class="topbar" id="topbar">
      {chapter ? (
        <a class="topbar-meta-link" href={homeUrl} aria-label="Zum Index">
          <span class="topbar-line1">
            <span class="topbar-site">Mantren</span>
            {number && <span class="topbar-num">{number}</span>}
          </span>
          <span class="topbar-chapter">{chapter}</span>
          <span class="topbar-section" id="topbar-section"></span>
        </a>
      ) : (
        <a class="topbar-title" href={homeUrl}>Mantren</a>
      )}
      <div class="topbar-actions">
        <button class="icon-btn" id="theme-toggle" type="button" title="Hell / Dunkel">◐</button>
      </div>
    </header>

    <main class={center ? 'center' : ''}>
      <slot />
    </main>

    <script is:inline>
      (function () {
        var html = document.documentElement;
        var body = document.body;

        var themeBtn = document.getElementById('theme-toggle');
        if (themeBtn) {
          themeBtn.addEventListener('click', function () {
            var isDark = html.classList.toggle('theme-invert');
            try { localStorage.setItem('theme', isDark ? 'dark' : 'light'); } catch (e) {}
          });
        }

        // Topbar bei Runterscrollen ausblenden, bei Hochscrollen wieder zeigen
        var topbar = document.getElementById('topbar');
        if (topbar) {
          var lastY = window.scrollY;
          var ticking = false;
          var update = function () {
            var y = window.scrollY;
            var dy = y - lastY;
            if (y < 96) {
              topbar.classList.remove('topbar-hidden');
            } else if (dy > 4) {
              topbar.classList.add('topbar-hidden');
            } else if (dy < -4) {
              topbar.classList.remove('topbar-hidden');
            }
            lastY = y;
            ticking = false;
          };
          window.addEventListener('scroll', function () {
            if (!ticking) {
              window.requestAnimationFrame(update);
              ticking = true;
            }
          }, { passive: true });
        }

        // Dritte Header-Zeile zeigt aktuellen Titel oder Zwischentitel
        var sectionEl = document.getElementById('topbar-section');
        if (sectionEl) {
          var headings = Array.prototype.slice.call(
            document.querySelectorAll('h1.mantra-title, h2.section-head')
          );
          if (headings.length) {
            var currentText = '';
            var pickActive = function () {
              var off = (topbar ? topbar.offsetHeight : 0) + 8;
              var lastAbove = null;
              for (var i = 0; i < headings.length; i++) {
                if (headings[i].getBoundingClientRect().top <= off) {
                  lastAbove = headings[i];
                } else {
                  break;
                }
              }
              return lastAbove || headings[0];
            };
            var refresh = function () {
              var active = pickActive();
              var text = active ? active.textContent.trim() : '';
              if (text !== currentText) {
                currentText = text;
                sectionEl.textContent = text;
              }
            };
            refresh();
            window.addEventListener('scroll', refresh, { passive: true });
            window.addEventListener('resize', refresh);
          }
        }

        document.addEventListener('keydown', function (e) {
          if (e.target instanceof HTMLElement) {
            var tag = e.target.tagName;
            if (tag === 'INPUT' || tag === 'TEXTAREA' || e.target.isContentEditable) return;
          }
          var prev = document.querySelector('a[data-pager="prev"]');
          var next = document.querySelector('a[data-pager="next"]');
          if (e.key === 'ArrowLeft' && prev) { e.preventDefault(); prev.click(); }
          if (e.key === 'ArrowRight' && next) { e.preventDefault(); next.click(); }
        });

        // Wischen links/rechts blättert wie eine Buchseite
        var touchStart = null;
        document.addEventListener('touchstart', function (e) {
          if (e.touches.length !== 1) { touchStart = null; return; }
          touchStart = {
            x: e.touches[0].clientX,
            y: e.touches[0].clientY,
            t: Date.now(),
          };
        }, { passive: true });

        document.addEventListener('touchend', function (e) {
          if (!touchStart) return;
          var t = e.changedTouches[0];
          var dx = t.clientX - touchStart.x;
          var dy = t.clientY - touchStart.y;
          var dt = Date.now() - touchStart.t;
          touchStart = null;
          if (dt > 700) return;
          if (Math.abs(dx) < 60) return;
          if (Math.abs(dy) > Math.abs(dx) * 0.6) return;
          var prev = document.querySelector('a[data-pager="prev"]');
          var next = document.querySelector('a[data-pager="next"]');
          if (dx > 0 && prev) prev.click();
          else if (dx < 0 && next) next.click();
        }, { passive: true });
      })();
    </script>
  </body>
</html>

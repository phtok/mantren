---
import type { Mantra } from '../lib/mantren';

interface Props {
  mantra: Mantra;
}

const { mantra } = Astro.props;

function renderLine(line: string) {
  if (line.startsWith('/')) {
    return { text: line.slice(1), indent: true };
  }
  return { text: line, indent: false };
}
---
<article class="mantra">

  <div class="mantra-body">
    {mantra.parts.map((part) => (
      <section class="part">
        {part.regie && <p class="regie">{part.regie}</p>}
        {part.section && <h2 class="section-head">{part.section}</h2>}
        {part.lines && part.lines.length > 0 && (
          <p class="lines">
            {part.lines.map((raw, i) => {
              const { text, indent } = renderLine(raw);
              return (
                <>
                  <span class={`line${indent ? ' line-indent' : ''}`}>{text}</span>
                  {i < part.lines!.length - 1 && '\n'}
                </>
              );
            })}
          </p>
        )}
      </section>
    ))}
  </div>
</article>

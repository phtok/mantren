---
import type { Vortrag } from '../lib/vortraege';
import { tx } from '../lib/typografie';

interface Props {
  vortrag: Vortrag;
}

const { vortrag } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

function assetUrl(path: string): string {
  if (/^(https?:|\/)/.test(path)) return path;
  return `${base}${path}`;
}

// Vorlesefunktion vorerst nur beim ersten Vortrag testen.
const ttsEnabled = vortrag.id === 'stunde-1';
---
<article class="vortrag" data-tts={ttsEnabled ? 'ready' : undefined}>
  <header class="vortrag-head">
    <h1 class="vortrag-titel">{tx(vortrag.titel)}</h1>
    <p class="vortrag-meta">
      <span>{tx(vortrag.ort)}</span>
      <span class="vortrag-meta-sep">·</span>
      <time datetime={vortrag.datum}>{vortrag.datum}</time>
      <span class="vortrag-meta-sep">·</span>
      <span>GA {vortrag.ga}, S. {vortrag.seiten}</span>
    </p>
  </header>

  {ttsEnabled && (
    <div class="tts-player" role="region" aria-label="Vorlesefunktion">
      <button type="button" class="tts-link js-tts-play">Vorlesen</button>
      <button type="button" class="tts-link js-tts-pause" hidden>Pause</button>
      <button type="button" class="tts-link js-tts-stop" hidden>Stopp</button>
      <select class="tts-voice js-tts-voice" aria-label="Stimme wählen" title="Stimme wählen">
        <option value="">…lädt</option>
      </select>
      <label class="tts-rate" title="Tempo">
        <input type="range" class="js-tts-rate" min="0.6" max="1.3" step="0.05" value="0.95" aria-label="Tempo" />
      </label>
    </div>
  )}

  <div class="vortrag-body">
    {vortrag.abschnitte.map((a, i) => {
      const isVerse = a.typ === 'mantram' || a.typ === 'wiederholung';
      const paragraphs = !isVerse && a.text ? a.text.split('\n\n') : [];
      const verseLines = isVerse && a.text ? a.text.split('\n') : [];
      return (
        <section id={a.anker} class={`abschnitt abschnitt-${a.typ}`} data-tts-chunk={ttsEnabled ? String(i) : undefined}>
          {a.seite && <span class="abschnitt-seite" aria-label={`Druckseite ${a.seite}`}>{a.seite}</span>}
          {a.titel && <h2 class="abschnitt-titel">{tx(a.titel)}</h2>}
          {isVerse && verseLines.length > 0 && (
            <div class="vortrag-lines">
              {verseLines.map((line) => (
                line === '' ? <div class="line-break" aria-hidden="true"></div> : <span class="line">{tx(line)}</span>
              ))}
            </div>
          )}
          {!isVerse && paragraphs.map((p) => <p class="abschnitt-text">{tx(p)}</p>)}
          {a.bild && (
            <figure class="abschnitt-bild">
              <img src={assetUrl(a.bild)} alt={tx(a.alt || '')} loading="lazy" />
              {a.quelle && <figcaption>{tx(a.quelle)}</figcaption>}
            </figure>
          )}
        </section>
      );
    })}
  </div>

  {vortrag.faksimile_url && (
    <footer class="vortrag-faksimile">
      <a class="vortrag-faksimile-link" href={vortrag.faksimile_url} target="_blank" rel="noopener noreferrer">
        Faksimile der Klartextnachschrift (PDF) ↗
      </a>
      {vortrag.faksimile_hinweis && (
        <p class="vortrag-faksimile-hinweis">{tx(vortrag.faksimile_hinweis)}</p>
      )}
    </footer>
  )}
</article>

{ttsEnabled && (
<script is:inline>
  (function () {
    var root = document.querySelector('[data-tts="ready"]');
    if (!root) return;
    var playBtn = root.querySelector('.js-tts-play');
    var pauseBtn = root.querySelector('.js-tts-pause');
    var stopBtn = root.querySelector('.js-tts-stop');
    var rateInput = root.querySelector('.js-tts-rate');
    var voiceSelect = root.querySelector('.js-tts-voice');

    if (!('speechSynthesis' in window) || !('SpeechSynthesisUtterance' in window)) {
      if (playBtn) { playBtn.disabled = true; playBtn.title = 'Browser unterstützt keine Sprachausgabe'; }
      return;
    }

    var synth = window.speechSynthesis;
    var chunks = Array.prototype.slice.call(root.querySelectorAll('[data-tts-chunk]'));
    var idx = 0;
    var current = null;
    var state = 'idle'; // idle | playing | paused
    var voices = [];
    var selectedVoiceURI = '';
    try { selectedVoiceURI = localStorage.getItem('mantren:tts-voice') || ''; } catch (e) {}
    var keepAliveTimer = null;

    function voiceLabel(v) {
      var quality = !v.localService ? ' · online' : '';
      return v.name + ' (' + v.lang + ')' + quality;
    }
    function germanVoices() {
      return voices.filter(function (v) { return v.lang && v.lang.toLowerCase().indexOf('de') === 0; });
    }
    function pickDefault() {
      var de = germanVoices();
      if (de.length === 0) return null;
      // Premium-/Enhanced-Stimmen klingen meist deutlich besser → nach vorn
      var score = function (v) {
        var n = (v.name || '').toLowerCase();
        var s = 0;
        if (/premium|enhanced|neural|natural|wavenet/.test(n)) s += 100;
        if (v.localService) s += 10;
        return s;
      };
      de.sort(function (a, b) { return score(b) - score(a); });
      return de[0];
    }
    function currentVoice() {
      if (selectedVoiceURI) {
        var hit = voices.filter(function (v) { return v.voiceURI === selectedVoiceURI; })[0];
        if (hit) return hit;
      }
      return pickDefault();
    }
    function populateVoiceSelect() {
      if (!voiceSelect) return;
      var score = function (v) {
        var n = (v.name || '').toLowerCase();
        var s = 0;
        if (/premium|enhanced|neural|natural|wavenet/.test(n)) s += 100;
        if (v.localService) s += 10;
        return s;
      };
      var de = germanVoices().slice().sort(function (a, b) { return score(b) - score(a); });
      var others = voices.filter(function (v) { return v.lang && v.lang.toLowerCase().indexOf('de') !== 0; }).sort(function (a, b) { return score(b) - score(a); });
      var def = currentVoice();
      voiceSelect.innerHTML = '';
      if (voices.length === 0) {
        var opt0 = document.createElement('option');
        opt0.value = '';
        opt0.textContent = 'keine Stimme verfügbar';
        voiceSelect.appendChild(opt0);
        voiceSelect.disabled = true;
        return;
      }
      voiceSelect.disabled = false;
      function appendGroup(label, list) {
        if (list.length === 0) return;
        var grp = document.createElement('optgroup');
        grp.label = label;
        list.forEach(function (v) {
          var opt = document.createElement('option');
          opt.value = v.voiceURI;
          opt.textContent = voiceLabel(v);
          if (def && v.voiceURI === def.voiceURI) opt.selected = true;
          grp.appendChild(opt);
        });
        voiceSelect.appendChild(grp);
      }
      appendGroup('Deutsch (' + de.length + ')', de);
      appendGroup('andere Sprachen (' + others.length + ')', others);
      // Diagnostik-Hinweis auf der Konsole für Power-User
      try { console.info('[tts] verfügbare Stimmen', voices.length, '— deutsch:', de.length); } catch (e) {}
    }
    function refreshVoices() {
      voices = synth.getVoices();
      populateVoiceSelect();
    }
    refreshVoices();
    if (typeof synth.addEventListener === 'function') {
      synth.addEventListener('voiceschanged', refreshVoices);
    }
    if (voiceSelect) {
      voiceSelect.addEventListener('change', function () {
        selectedVoiceURI = voiceSelect.value;
        try { localStorage.setItem('mantren:tts-voice', selectedVoiceURI); } catch (e) {}
        if (state === 'playing') {
          synth.cancel();
          speakAt(idx);
        }
      });
    }

    function setState(s) {
      state = s;
      if (playBtn) playBtn.hidden = (s === 'playing');
      if (pauseBtn) pauseBtn.hidden = (s !== 'playing');
      if (stopBtn) stopBtn.hidden = (s === 'idle');
    }

    function collectText(el) {
      var clone = el.cloneNode(true);
      var drop = clone.querySelectorAll('.abschnitt-seite, figure');
      for (var i = 0; i < drop.length; i++) drop[i].parentNode.removeChild(drop[i]);
      return clone.textContent.replace(/\s+/g, ' ').trim();
    }

    // Chrome cancelt Sprachausgabe nach ~15s spontan; periodisches resume hält sie wach.
    function startKeepAlive() {
      stopKeepAlive();
      keepAliveTimer = window.setInterval(function () {
        if (state === 'playing' && synth.speaking && !synth.paused) {
          synth.pause();
          synth.resume();
        }
      }, 9000);
    }
    function stopKeepAlive() {
      if (keepAliveTimer != null) { window.clearInterval(keepAliveTimer); keepAliveTimer = null; }
    }

    function highlight(el) {
      if (current && current !== el) current.classList.remove('tts-current');
      current = el;
      if (!current) return;
      current.classList.add('tts-current');
      // Nur scrollen, wenn der Abschnitt nicht ohnehin im Sichtfeld liegt.
      try {
        var rect = current.getBoundingClientRect();
        var vh = window.innerHeight || document.documentElement.clientHeight;
        var inView = rect.top >= 64 && rect.bottom <= vh - 32;
        if (!inView) current.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } catch (e) {}
    }

    function speakAt(i) {
      if (i >= chunks.length) { finish(); return; }
      var el = chunks[i];
      var text = collectText(el);
      if (!text) { idx = i + 1; speakAt(idx); return; }
      highlight(el);
      var u = new SpeechSynthesisUtterance(text);
      u.lang = 'de-DE';
      u.rate = parseFloat(rateInput && rateInput.value) || 1;
      u.pitch = 1;
      var v = currentVoice();
      if (v) { u.voice = v; u.lang = v.lang || 'de-DE'; }
      u.onend = function () {
        idx = i + 1;
        if (state === 'playing') speakAt(idx);
      };
      u.onerror = function () {
        idx = i + 1;
        if (state === 'playing') speakAt(idx);
      };
      synth.speak(u);
    }

    function finish() {
      stopKeepAlive();
      if (current) current.classList.remove('tts-current');
      current = null;
      idx = 0;
      setState('idle');
    }

    if (playBtn) playBtn.addEventListener('click', function () {
      if (state === 'paused') {
        synth.resume();
        setState('playing');
        startKeepAlive();
        return;
      }
      synth.cancel();
      idx = 0;
      setState('playing');
      startKeepAlive();
      speakAt(idx);
    });
    if (pauseBtn) pauseBtn.addEventListener('click', function () {
      if (state === 'playing') {
        synth.pause();
        setState('paused');
      }
    });
    if (stopBtn) stopBtn.addEventListener('click', function () {
      synth.cancel();
      finish();
    });
    if (rateInput) rateInput.addEventListener('change', function () {
      // Bei laufender Wiedergabe: aktuelles Chunk neu mit neuem Tempo starten
      if (state === 'playing') {
        synth.cancel();
        speakAt(idx);
      }
    });

    // Nicht weiterquatschen, wenn man die Seite verlässt.
    window.addEventListener('pagehide', function () { synth.cancel(); stopKeepAlive(); });
    window.addEventListener('beforeunload', function () { synth.cancel(); stopKeepAlive(); });
  })();
</script>
)}
